{
	"compatibility_date": "2026-05-31",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "songcorgi-s-blog",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",            // 你代码中使用的变量名
			"id": "e8445e1350254fd39c8ffc1fbe16cc8b"      // 从上一步复制来的 id
		}
	]
}