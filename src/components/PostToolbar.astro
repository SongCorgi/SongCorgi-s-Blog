---
import type { TimelinePost } from "../utils/post";
import DesktopToolbar from "./DesktopToolbar.astro";

interface Props {
  tocHtml: string;
  currentSet: { name: string; count: number; posts: TimelinePost[] } | undefined;
  currentSetIndex: number;
  setPosts: TimelinePost[];
  slug: string;
  firstTag: string | null;
  prevPost: { id: string; data: { title: string } } | null;
  nextPost: { id: string; data: { title: string } } | null;
}

const {
  tocHtml,
  currentSet,
  currentSetIndex,
  setPosts,
  slug,
  firstTag,
  prevPost,
  nextPost,
} = Astro.props;

function renderSetList(): string {
  if (!setPosts.length) return "";
  let h = "";
  for (const sp of setPosts) {
    const isCurrent = sp.slug === slug;
    h += `<a href="/posts/${sp.slug}" class="block text-base transition-colors no-underline py-0.5 break-words whitespace-normal ${
      isCurrent
        ? "text-accent font-medium bg-accent/10 rounded px-2 -mx-2"
        : "text-black dark:text-ghost hover:text-accent"
    }" title="${sp.title}">${sp.title}</a>`;
  }
  return h;
}

const setListHtml = renderSetList();
const hasSet = !!currentSet;
const currentSetName = currentSet?.name ?? "";
const setPostsCount = currentSet?.posts.length ?? 0;
---

<style is:inline>
  .panel-btn-group { position: relative; display: flex; justify-content: center }
  .panel-btn-group > button { position: relative; z-index: 1 }
  .panel-card { position: absolute; top: 0; right: calc(100% + 1rem); width: 14rem; overflow: visible; transition: opacity 0.28s ease 0.14s, transform 0.28s ease 0.14s }
  .panel-card.closed { opacity: 0; pointer-events: none; transform: translateX(12px); transition: opacity 0.2s ease 0s, transform 0.2s ease 0s }
  .panel-content-body { background: #FFFBF1; border-radius: 0 0 12px 12px; box-shadow: 0 4px 16px rgba(0,0,0,0.1); padding: clamp(0.75rem, 1.5vw, 1.25rem) 1rem; max-height: 60vh; overflow-y: scroll; transition: box-shadow 0.28s ease 0.14s }
  .panel-card.closed .panel-content-body { box-shadow: 0 0 0 transparent; transition: box-shadow 0.2s ease 0s }
  .panel-header-bar { min-height: 40px; display: flex; align-items: center; justify-content: space-between; padding: 0.375rem 0.75rem 0.375rem 1rem; background: #EDDCC8; border-radius: 12px 0 0 0; position: relative; z-index: 1; overflow-wrap: break-word; word-break: break-all }
  .dark .panel-header-bar { background: var(--color-active-bg-dark) }
  .dark .panel-card::before { background: var(--color-active-bg-dark) }
  .dark .panel-content-body { background: var(--color-night); box-shadow: 0 4px 16px rgba(0,0,0,0.4) }
  #side-toolbar { position: fixed; z-index: 40; transition: top 0.3s ease }
  @media (min-width: 1280px) { #side-toolbar { visibility: hidden } }

  /* 胶囊淡入淡出 + 极小视口滚动兜底 */
  #capsule { transition: opacity 0.25s ease }
  #capsule.capsule-hidden { opacity: 0; pointer-events: none }
  #capsule.capsule-scroll { overflow-y: auto }

  /* 汉堡拖拽光标 */
  #btn-hamburger:active { cursor: grabbing }

  .panel-card::before { content: ''; position: absolute; top: 0; right: -3.5rem; width: calc(3.5rem + 4px); height: 40px; background: #EDDCC8; border-radius: 4px 10px 10px 4px; z-index: 0; pointer-events: none }

  .dpad-btn-group { display: flex; flex-direction: column; align-items: center; position: relative; border-radius: 10px; background: transparent; transition: background 0.2s ease }
  .dpad-btn-group:has(.dpad-menu-body:not(.dpad-collapsed)) { background: rgba(208,125,42,0.1); border-radius: 14px }
  .dark .dpad-btn-group:has(.dpad-menu-body:not(.dpad-collapsed)) { background: rgba(236,154,70,0.15) }
  .dpad-menu-body { display: flex; flex-direction: column; align-items: center; gap: 0.25rem; padding: 0.375rem 0.25rem 0.5rem; overflow: hidden; transition: max-height 0.25s ease, opacity 0.2s ease, padding 0.25s ease; max-height: 300px; opacity: 1 }
  .dpad-menu-body.dpad-collapsed { max-height: 0; opacity: 0; padding-top: 0; padding-bottom: 0; pointer-events: none }
  .dpad-btn-group .toolbar-btn,.dpad-menu-body .toolbar-btn,.dpad-menu-body .dpad-sub { position: relative; z-index: 1; background: transparent !important; border: none !important }
</style>

<div
  id="mobile-overlay"
  class="fixed inset-0 bg-black/30 backdrop-blur-sm z-40 opacity-0 pointer-events-none transition-opacity duration-300"
  aria-hidden="true"
></div>

<DesktopToolbar
  tocHtml={tocHtml}
  setListHtml={setListHtml}
  hasSet={hasSet}
  currentSetName={currentSetName}
  currentSetIndex={currentSetIndex}
  setPostsCount={setPostsCount}
  firstTag={firstTag}
  prevPost={prevPost}
  nextPost={nextPost}
/>

<style>
  #dpad-menu { max-height: 300px; opacity: 1 }

  .toc-link-active { color: #D07D2A !important }
  :root.dark .toc-link-active { color: #EC9A46 !important }


  .set-link:hover { color: var(--color-accent) !important }
</style>

<style is:global>
  :root { --color-active-bg-dark: #3E2618 }
  :root { --color-progress-fill: #B3621A }
  :root.dark { --color-progress-fill: #D08038 }
  .toc-progress-fill { display: block; background-color: var(--color-progress-fill) }
  :root .toc-progress { background: rgba(92, 61, 46, 0.25) }
  :root.dark .toc-progress { background: rgba(170, 120, 90, 0.2) }
</style>

<script data-astro-rerun>
  /* ======== TOC 区段式滚动高亮 + 进度条跟踪 ======== */
  function initTocTracker(addWinListener) {
    let visibleArticle = null;
    let sections = [];

    function rebuildSections() {
      visibleArticle = Array.from(document.querySelectorAll('[data-pagefind-body]')).find(
        (el) => el.checkVisibility(),
      );
      const headingEls = visibleArticle
        ? visibleArticle.querySelectorAll("h2[id], h3[id], h4[id], h5[id], h6[id]")
        : [];
      sections = [];
      for (let i = 0; i < headingEls.length; i++) {
        sections.push({
          id: headingEls[i].id,
          start: headingEls[i],
          end: headingEls[i + 1] ?? null,
        });
      }
    }
    rebuildSections();
    if (sections.length === 0) return () => {};

    const tocContentEl = document.getElementById("toc-content");
    const highlightFrame = document.getElementById("toc-highlight-frame");

    function updateSectionHighlights() {
      if (sections.length > 0 && !sections[0].start.checkVisibility()) rebuildSections();
      const viewportBottom = window.innerHeight;
      const activeIds = new Set();
      for (const sec of sections) {
        const sectionTop = sec.start.getBoundingClientRect().top;
        const sectionBottom = sec.end
          ? sec.end.getBoundingClientRect().top
          : (visibleArticle?.getBoundingClientRect().bottom ?? document.documentElement.scrollHeight - window.scrollY);
        if (sectionTop < viewportBottom && sectionBottom > 0) {
          activeIds.add(sec.id);
        }
      }

      document.querySelectorAll("[data-toc-link]").forEach((el) => {
        const id = el.getAttribute("data-toc-link");
        if (id && activeIds.has(id)) {
          el.classList.add("toc-link-active");
        } else {
          el.classList.remove("toc-link-active");
        }
      });

      if (highlightFrame && tocContentEl) {
        const activeLinks = tocContentEl.querySelectorAll(".toc-link-active");
        if (activeLinks.length > 0) {
          const containerRect = tocContentEl.getBoundingClientRect();
          let minTop = Infinity;
          let maxBottom = -Infinity;
          for (const link of activeLinks) {
            const r = link.getBoundingClientRect();
            const top = r.top - containerRect.top + tocContentEl.scrollTop;
            const bottom = r.bottom - containerRect.top + tocContentEl.scrollTop;
            if (top < minTop) minTop = top;
            if (bottom > maxBottom) maxBottom = bottom;
          }
          highlightFrame.style.top = (minTop - 8) + "px";
          highlightFrame.style.height = (maxBottom - minTop + 16) + "px";
          highlightFrame.style.opacity = "1";

          const viewTop = tocContentEl.scrollTop;
          const viewBottom = viewTop + tocContentEl.clientHeight;
          const pad = 8;
          let targetTop = null;
          if (minTop < viewTop + pad) {
            targetTop = minTop - pad;
          } else if (maxBottom > viewBottom - pad) {
            targetTop = maxBottom - tocContentEl.clientHeight + pad;
          }
          if (targetTop !== null) {
            const start = tocContentEl.scrollTop;
            const distance = targetTop - start;
            const duration = 180;
            const startTime = performance.now();
            function easeOutCubic(t) { return 1 - Math.pow(1 - t, 3); }
            function animateScroll(now) {
              const elapsed = now - startTime;
              const t = Math.min(elapsed / duration, 1);
              tocContentEl.scrollTop = start + distance * easeOutCubic(t);
              if (t < 1) requestAnimationFrame(animateScroll);
            }
            requestAnimationFrame(animateScroll);
          }
        } else {
          highlightFrame.style.opacity = "0";
        }
      }

      /* 进度条 */
      let firstActiveIdx = -1;
      let lastActiveIdx = -1;
      for (let i = 0; i < sections.length; i++) {
        if (activeIds.has(sections[i].id)) {
          if (firstActiveIdx === -1) firstActiveIdx = i;
          lastActiveIdx = i;
        }
      }

      const progressBars = document.querySelectorAll(".toc-progress");
      for (const bar of progressBars) {
        const fill = bar.querySelector(".toc-progress-fill");
        if (!fill) continue;
        const slug = fill.getAttribute("data-progress-for");
        const secIdx = sections.findIndex((s) => s.id === slug);
        if (secIdx === -1) continue;
        const sec = sections[secIdx];

        if (firstActiveIdx === -1) {
          const top = sec.start.getBoundingClientRect().top;
          bar.style.visibility = top >= window.innerHeight ? "hidden" : "visible";
          if (bar.style.visibility === "visible") { fill.style.height = "100%"; fill.style.background = "var(--color-progress-fill)"; }
          continue;
        }

        if (secIdx > lastActiveIdx) {
          bar.style.visibility = "hidden";
          continue;
        }
        bar.style.visibility = "visible";

        if (secIdx < firstActiveIdx) {
          fill.style.height = "100%";
          fill.style.background = "var(--color-progress-fill)";
        } else if (secIdx <= lastActiveIdx) {
          const atBottom = (window.innerHeight + window.scrollY) >= (document.body.scrollHeight - 5);
          if (atBottom) {
            fill.style.height = "100%";
            fill.style.background = "var(--color-progress-fill)";
            continue;
          }
          const sectionStart = sec.start.getBoundingClientRect().top + window.scrollY;
          const sectionEnd = sec.end
            ? sec.end.getBoundingClientRect().top + window.scrollY
            : (visibleArticle?.getBoundingClientRect().bottom ?? 0) + window.scrollY;
          const progress = (sectionEnd - sectionStart) > 0
            ? Math.max(0, Math.min(1, (window.scrollY - sectionStart) / (sectionEnd - sectionStart)))
            : 0;
          fill.style.height = (progress * 100) + "%";
          fill.style.background = "var(--color-progress-fill)";
        } else {
          fill.style.height = "0%";
        }
      }
    }

    let sectionRaf = false;
    addWinListener("scroll", () => {
      if (sectionRaf) return;
      sectionRaf = true;
      requestAnimationFrame(() => {
        sectionRaf = false;
        updateSectionHighlights();
      });
    }, { passive: true });

    requestAnimationFrame(() => updateSectionHighlights());
    addWinListener("resize", () => updateSectionHighlights());

    return updateSectionHighlights;
  }

  /* ======== 面板互斥切换 + D-pad + TOC 交互 ======== */

  /* ClientRouter 导航前清理上一页注册的 window 监听器 */
  const _tocWinListeners = [];
  function _tocAddWinListener(type, listener, options) {
    window.addEventListener(type, listener, options);
    _tocWinListeners.push([type, listener, options]);
  }
  function _tocCleanup() {
    saveToolbarState();
    for (const [type, listener, options] of _tocWinListeners) {
      window.removeEventListener(type, listener, options);
    }
    _tocWinListeners.length = 0;
  }
  document.addEventListener('astro:before-swap', _tocCleanup, { once: true });

  /* ---- DOM 引用 ---- */
  function isMobile() { return window.innerWidth < 1280; }

  const panelTocWrap = document.getElementById("panel-toc-wrap");
  const panelSetWrap = document.getElementById("panel-set-wrap");
  const btnToc = document.getElementById("btn-toc");
  const btnSet = document.getElementById("btn-set");
  const dpadBtn = document.getElementById("btn-dpad");
  const dpadMenu = document.getElementById("dpad-menu");
  const mobileOverlay = document.getElementById("mobile-overlay");

  /* ---- 当前激活面板 ---- */
  let activePanel = null;
  let dpadOpen = false;

  /* ---- 胶囊独立定位 ---- */
  const toolbarEl = document.getElementById("side-toolbar");
  let _ptRafId = 0;
  function positionToolbar() {
    const postLayoutEl = document.getElementById("post-layout");
    if (!postLayoutEl || !toolbarEl) return;
    if (isMobile()) {
      toolbarEl.style.left = "";
      toolbarEl.style.right = "";
      toolbarEl.style.visibility = "visible";
      return;
    }
    const wrap = document.getElementById("article-wrap");
    if (!wrap) return;
    const wrapRect = wrap.getBoundingClientRect();
    if (wrapRect.width === 0 && wrapRect.height === 0) {
      /* CSS 尚未应用，等待下一帧重试 */
      cancelAnimationFrame(_ptRafId);
      _ptRafId = requestAnimationFrame(positionToolbar);
      return;
    }
    const remSize = parseFloat(getComputedStyle(document.documentElement).fontSize);
    toolbarEl.style.right = "";
    toolbarEl.style.left = (wrapRect.right + 1 * remSize) + "px";
    toolbarEl.style.visibility = "visible";
  }
  /* 初次加载脚本位于 #post-layout 之前，延迟到 DOM 就绪再执行 */
  function onReady(fn) {
    fn();
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", fn);
    }
  }
  onReady(positionToolbar);
  let _wasMobile = isMobile();
  window.addEventListener("resize", () => {
    positionToolbar();
    recalcAutoShift();
    const nowMobile = isMobile();
    if (!_wasMobile && nowMobile) closeAllPanels();
    _wasMobile = nowMobile;
  });
  let _tbRaf = false;
  window.addEventListener("scroll", () => {
    if (_tbRaf) return;
    _tbRaf = true;
    requestAnimationFrame(() => {
      _tbRaf = false;
      positionToolbar();
      recalcAutoShift();
    });
  }, { passive: true });

  /* ======== 汉堡按钮：拖拽移动 + 切换显隐 + 智能避让 ======== */
  function getRemSize() {
    return parseFloat(getComputedStyle(document.documentElement).fontSize);
  }
  const btnHamburger = document.getElementById("btn-hamburger");
  const capsuleEl = document.getElementById("capsule");
  const BASE_TOP_REM = 13;
  const VIEW_MARGIN = 12;
  const HEADER_GAP = 8;
  let userOffsetPx = 0;
  let autoShiftPx = 0;
  let capsuleVisible = true;

  function applyTop() {
    if (!toolbarEl) return;
    toolbarEl.style.top = `calc(${BASE_TOP_REM}rem + ${userOffsetPx + autoShiftPx}px)`;
  }

  function neededHeight() {
    if (!btnHamburger || !capsuleEl) return 0;
    return capsuleEl.getBoundingClientRect().bottom - btnHamburger.getBoundingClientRect().top;
  }

  function getHeaderBottom() {
    const h = document.getElementById("site-header");
    if (!h) return 0;
    return h.getBoundingClientRect().bottom;
  }

  let _asRaf = 0;
  function recalcAutoShift() {
    cancelAnimationFrame(_asRaf);
    _asRaf = requestAnimationFrame(() => {
      if (!capsuleEl || !btnHamburger) return;
      if (!capsuleVisible) {
        capsuleEl.classList.remove("capsule-scroll");
        capsuleEl.style.maxHeight = "";

        const rem = getRemSize();
        const hamburgerH = btnHamburger.offsetHeight;
        const viewH = window.innerHeight;
        const minTop = Math.max(getHeaderBottom() + HEADER_GAP, VIEW_MARGIN);
        const baseTop = BASE_TOP_REM * rem + userOffsetPx;

        /* 底部溢出：汉堡不超出视口下边缘 */
        autoShiftPx = 0;
        const hamburgerBottom = baseTop + hamburgerH;
        if (hamburgerBottom > viewH - VIEW_MARGIN) {
          autoShiftPx = -(hamburgerBottom - viewH + VIEW_MARGIN);
        }

        /* 顶部避让：汉堡不侵入 header */
        if (baseTop + autoShiftPx < minTop) {
          autoShiftPx = minTop - baseTop;
        }
      } else {
        const rem = getRemSize();

        /* 面板超出胶囊底部的额外高度 */
        let panelExtra = 0;
        if (activePanel && capsuleEl) {
          const panel = activePanel === 'toc' ? panelTocWrap : panelSetWrap;
          if (panel && !panel.classList.contains("closed")) {
            const capBottom = capsuleEl.getBoundingClientRect().bottom;
            const panelBottom = panel.getBoundingClientRect().bottom;
            panelExtra = Math.max(0, panelBottom - capBottom);
          }
        }

        const need = neededHeight() + panelExtra;
        const viewH = window.innerHeight;
        const avail = viewH - VIEW_MARGIN - (BASE_TOP_REM * rem + userOffsetPx);
        autoShiftPx = need > avail ? -(need - avail) : 0;

        const minTop = Math.max(getHeaderBottom() + HEADER_GAP, VIEW_MARGIN);
        const actualTop = BASE_TOP_REM * rem + userOffsetPx + autoShiftPx;
        if (actualTop < minTop) {
          autoShiftPx = minTop - (BASE_TOP_REM * rem + userOffsetPx);
          const overflowAtMin = need - (viewH - VIEW_MARGIN - minTop);
          if (overflowAtMin > 0 && !activePanel) {
            const hamburgerH = btnHamburger.offsetHeight;
            const gap = 8;
            const maxCapH = viewH - VIEW_MARGIN - minTop - hamburgerH - gap;
            capsuleEl.classList.add("capsule-scroll");
            capsuleEl.style.maxHeight = maxCapH + "px";
          } else {
            capsuleEl.classList.remove("capsule-scroll");
            capsuleEl.style.maxHeight = "";
          }
        } else {
          capsuleEl.classList.remove("capsule-scroll");
          capsuleEl.style.maxHeight = "";
        }
      }
      applyTop();
    });
  }

  function toggleCapsule() {
    if (!capsuleEl) return;
    capsuleVisible = !capsuleVisible;
    if (capsuleVisible) {
      capsuleEl.classList.remove("capsule-hidden");
    } else {
      capsuleEl.classList.add("capsule-hidden");
    }
    recalcAutoShift();
  }

  let justDragged = false;

  if (btnHamburger) {
    let isDragging = false;
    let dragStartY = 0;
    let dragStartOffset = 0;
    let hasDragged = false;

    function getDragClamp(rawPx) {
      const rem = getRemSize();
      const minTop = Math.max(getHeaderBottom() + HEADER_GAP, VIEW_MARGIN);
      /* 下限：确保汉堡至少 20px 可见 */
      const maxByHamburger = window.innerHeight - (btnHamburger?.offsetHeight ?? 36) - 20;
      let maxTop = maxByHamburger;
      /* 胶囊可见时，更严格的限制：胶囊底部不得超出视口 */
      if (capsuleVisible && capsuleEl) {
        const capH = capsuleEl.getBoundingClientRect().bottom - (btnHamburger?.getBoundingClientRect().top ?? 0);
        const maxByCapsule = window.innerHeight - VIEW_MARGIN - capH;
        if (maxByCapsule < maxTop) maxTop = maxByCapsule;
      }
      return Math.max(minTop - BASE_TOP_REM * rem, Math.min(maxTop - BASE_TOP_REM * rem, rawPx));
    }

    function onDragMove(e) {
      if (!isDragging) return;
      const deltaY = e.clientY - dragStartY;
      if (Math.abs(deltaY) > 3) hasDragged = true;
      if (!hasDragged) return;
      e.preventDefault();
      userOffsetPx = getDragClamp(dragStartOffset + deltaY);
      applyTop();
    }

    function onDragEnd() {
      if (isDragging) {
        isDragging = false;
        if (hasDragged) {
          justDragged = true;
          setTimeout(() => { justDragged = false; }, 0);
        }
        document.body.style.userSelect = "";
        btnHamburger.style.cursor = "";
        if (toolbarEl) toolbarEl.style.transition = "";
      }
      document.removeEventListener("pointermove", onDragMove);
      document.removeEventListener("pointerup", onDragEnd);
      document.removeEventListener("pointercancel", onDragEnd);
    }

    btnHamburger.addEventListener("pointerdown", (e) => {
      if (e.button !== 0) return;
      e.preventDefault();
      isDragging = true;
      hasDragged = false;
      dragStartY = e.clientY;
      userOffsetPx += autoShiftPx;
      dragStartOffset = userOffsetPx;
      autoShiftPx = 0;
      if (toolbarEl) toolbarEl.style.transition = "none";
      document.body.style.userSelect = "none";
      btnHamburger.style.cursor = "grabbing";
      document.addEventListener("pointermove", onDragMove);
      document.addEventListener("pointerup", onDragEnd);
      document.addEventListener("pointercancel", onDragEnd);
    });

    btnHamburger.addEventListener("pointerup", () => {
      if (isDragging && !hasDragged) {
        isDragging = false;
        document.body.style.userSelect = "";
        btnHamburger.style.cursor = "";
        if (toolbarEl) toolbarEl.style.transition = "";
        document.removeEventListener("pointermove", onDragMove);
        document.removeEventListener("pointerup", onDragEnd);
        document.removeEventListener("pointercancel", onDragEnd);
        toggleCapsule();
      }
    });

    applyTop();
  }

  const tBtnActiveClass = "!text-accent";

  /* ======== 状态持久化（跨导航记住面板/胶囊/位置） ======== */
  function saveToolbarState() {
    try {
      localStorage.setItem('post-toolbar-state', JSON.stringify({
        userOffsetPx,
        capsuleVisible,
        activePanel,
        dpadOpen,
      }));
    } catch(e) { /* quota exceeded, ignore */ }
  }

  function restoreToolbarState() {
    try {
      const raw = localStorage.getItem('post-toolbar-state');
      if (!raw) return;
      const state = JSON.parse(raw);
      if (typeof state.userOffsetPx === 'number') userOffsetPx = state.userOffsetPx;
      if (typeof state.capsuleVisible === 'boolean') capsuleVisible = state.capsuleVisible;

      /* 应用胶囊显隐 */
      if (!capsuleVisible && capsuleEl) {
        capsuleEl.classList.add("capsule-hidden");
      }

      /* 应用面板状态 */
      if (state.activePanel === 'toc' && panelTocWrap && btnToc) {
        activePanel = 'toc';
        panelTocWrap.classList.remove("closed");
        btnToc.className += " " + tBtnActiveClass;
        const ac = document.getElementById("article-content");
        if (isMobile()) {
          if (mobileOverlay) mobileOverlay.classList.remove("opacity-0", "pointer-events-none");
        } else if (ac) {
          ac.classList.add("narrowed");
        }
        requestAnimationFrame(() => updateSectionHighlights());
      } else if (state.activePanel === 'set' && panelSetWrap && btnSet) {
        activePanel = 'set';
        panelSetWrap.classList.remove("closed");
        btnSet.className += " " + tBtnActiveClass;
        const ac = document.getElementById("article-content");
        if (isMobile()) {
          if (mobileOverlay) mobileOverlay.classList.remove("opacity-0", "pointer-events-none");
        } else if (ac) {
          ac.classList.add("narrowed");
        }
      }

      /* 应用 D-pad 展开状态 */
      if (state.dpadOpen && dpadMenu && dpadBtn) {
        dpadOpen = true;
        dpadMenu.classList.remove("dpad-collapsed");
        dpadBtn.className += " " + tBtnActiveClass;
      }

      /* 应用位置并触发自动避让（延迟一帧等 CSS 落位） */
      applyTop();
      requestAnimationFrame(() => {
        positionToolbar();
        recalcAutoShift();
      });
    } catch(e) { /* ignore corrupt state */ }
  }

  function closeAllPanels() {
    if (panelTocWrap) panelTocWrap.classList.add("closed");
    if (panelSetWrap) panelSetWrap.classList.add("closed");
    if (btnToc) btnToc.className = btnToc.className.replace(tBtnActiveClass, "").replace(/\s+/g, " ").trim();
    if (btnSet) btnSet.className = btnSet.className.replace(tBtnActiveClass, "").replace(/\s+/g, " ").trim();
    const ac = document.getElementById("article-content");
    if (ac) ac.classList.remove("narrowed");
    if (mobileOverlay) mobileOverlay.classList.add("opacity-0", "pointer-events-none");
    activePanel = null;
    recalcAutoShift();
  }

  function openPanel(type) {
    if (activePanel === type) {
      closeAllPanels();
      return;
    }
    closeAllPanels();
    const mobile = isMobile();
    if (mobile && mobileOverlay) mobileOverlay.classList.remove("opacity-0", "pointer-events-none");
    if (type === 'toc' && panelTocWrap) {
      panelTocWrap.classList.remove("closed");
      if (btnToc) btnToc.className += " " + tBtnActiveClass;
      const articleContent = document.getElementById("article-content");
      if (!mobile && articleContent) articleContent.classList.add("narrowed");
      activePanel = 'toc';
      requestAnimationFrame(() => updateSectionHighlights());
    } else if (type === 'set' && panelSetWrap) {
      panelSetWrap.classList.remove("closed");
      if (btnSet) btnSet.className += " " + tBtnActiveClass;
      const articleContent = document.getElementById("article-content");
      if (!mobile && articleContent) articleContent.classList.add("narrowed");
      activePanel = 'set';
      positionToolbar();
    }
    recalcAutoShift();
  }

  if (btnToc) btnToc.addEventListener("click", () => openPanel('toc'));
  if (btnSet) btnSet.addEventListener("click", () => openPanel('set'));

  /* ---- D-pad 展开/折叠 ---- */
  if (dpadBtn && dpadMenu) {
    let dpadRafId = 0;

    function collapseDpad() {
      cancelAnimationFrame(dpadRafId);
      dpadOpen = false;
      recalcAutoShift();
      dpadMenu.classList.add("dpad-collapsed");
      dpadBtn.className = dpadBtn.className.replace(tBtnActiveClass, "").replace(/\s+/g, " ").trim();
      setTimeout(() => recalcAutoShift(), 300);
    }

    dpadBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      dpadOpen = !dpadOpen;
      if (dpadOpen) {
        dpadMenu.classList.remove("dpad-collapsed");
        dpadBtn.className += " " + tBtnActiveClass;
        /* 用 rAF 循环跟踪 dpad CSS 过渡，让 autoShift 随展开进度平滑移位 */
        const dpadExpandStart = performance.now();
        const dpadExpandDuration = 280;
        cancelAnimationFrame(dpadRafId);
        function trackDpadExpand(now) {
          recalcAutoShift();
          if (now - dpadExpandStart < dpadExpandDuration) {
            dpadRafId = requestAnimationFrame(trackDpadExpand);
          }
        }
        dpadRafId = requestAnimationFrame(trackDpadExpand);
      } else {
        collapseDpad();
      }
    });
    document.addEventListener("click", (e) => {
      if (justDragged) return;
      if (!dpadOpen) return;
      /* 不关闭：点击目标是导航链接，页面即将跳转，关闭无意义且会覆盖已保存的展开状态 */
      const link = e.target.closest('a[href]');
      if (link) {
        const href = link.getAttribute('href');
        if (href && !href.startsWith('#')) return;
      }
      if (!dpadBtn.contains(e.target) && !dpadMenu.contains(e.target) && !(btnHamburger && btnHamburger.contains(e.target)) && !(btnToc && btnToc.contains(e.target)) && !(btnSet && btnSet.contains(e.target))) {
        collapseDpad();
      }
    });
  }

  /* ---- D-pad 方向按钮 ---- */
  document.getElementById("dpad-up")?.addEventListener("click", (e) => {
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: "smooth" });
  });
  document.getElementById("dpad-down")?.addEventListener("click", (e) => {
    e.preventDefault();
    const giscus = document.querySelector(".giscus-container giscus-widget, .giscus-container .giscus");
    if (giscus) {
      giscus.scrollIntoView({ behavior: "smooth", block: "start" });
    } else {
      const article = document.getElementById("article-content");
      if (article) {
        const articleBottom = article.getBoundingClientRect().bottom + window.scrollY - window.innerHeight * 0.15;
        window.scrollTo({ top: articleBottom, behavior: "smooth" });
      }
    }
  });

  if (mobileOverlay) mobileOverlay.addEventListener("click", () => closeAllPanels());

  /* ======== TOC 平滑滚动 ======== */
  document.querySelectorAll("[data-toc-link]").forEach((link) => {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      const id = e.target.getAttribute("data-toc-link");
      if (!id) return;
      const target = document.getElementById(id);
      if (target) target.scrollIntoView({ behavior: "smooth" });
      closeAllPanels();
    });
  });

  /* ======== 区段式滚动高亮 ======== */
  let updateSectionHighlights = () => {};
  onReady(() => {
    updateSectionHighlights = initTocTracker(_tocAddWinListener);
    const hadSavedState = !!localStorage.getItem('post-toolbar-state');
    restoreToolbarState();
    if (!hadSavedState && !isMobile() && btnToc) {
      openPanel('toc');
    }
  });
</script>
