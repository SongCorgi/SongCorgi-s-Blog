---
import SearchPanel from "./SearchPanel.astro";

interface Props {
  tags: { name: string; count: number }[];
  sets: { name: string; count: number }[];
}

const { tags, sets } = Astro.props;
---

<!-- 搜索触发框 -->
<div class="text-center mb-8">
  <button
    id="open-search"
    class="w-full max-w-lg mx-auto flex items-center gap-3 px-4 py-3 rounded-xl border-2 border-border-light dark:border-border-dark bg-white/50 dark:bg-black text-muted dark:text-muted-dark hover:border-accent dark:hover:border-accent transition-colors cursor-pointer"
  >
    <svg
      class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
    >
      <circle cx="11" cy="11" r="8" />
      <path d="M21 21l-4.35-4.35" />
    </svg>
    <span class="text-sm">搜索文章、标签、合集...</span>
  </button>
</div>

<!-- 搜索浮层 -->
<div
  id="search-overlay"
  class="fixed inset-0 z-50 flex items-start justify-center pt-20 p-4 bg-cream/50 dark:bg-night/50 backdrop-blur-md hidden"
>
  <div
    class="relative bg-[#F5E6D3]/90 dark:bg-[#3B1F0E]/90 rounded-2xl shadow-2xl max-w-xl w-full p-6"
  >
    <button
      id="close-search"
      class="absolute -top-3 -right-3 w-8 h-8 rounded-full flex items-center justify-center text-lg text-muted dark:text-muted-dark bg-[#F5E6D3]/90 dark:bg-[#3B1F0E]/90 hover:text-accent dark:hover:text-accent shadow-md transition-colors border-0 cursor-pointer leading-none"
      aria-label="关闭搜索"
    >
      &times;
    </button>
    <div class="max-h-[80vh] overflow-y-auto pr-2">
      <SearchPanel
        filter="all"
        tagsJson={JSON.stringify(tags)}
        setsJson={JSON.stringify(sets.map(s => ({ name: s.name, count: s.count })))}
      />
    </div>
  </div>
</div>


<script>
  /* 搜索浮层开关 — 绑定逻辑提取为函数，供初始加载 + View Transition 后重新绑定 */

  function bindSearchOverlay() {
    const openBtn = document.getElementById("open-search");
    const overlay = document.getElementById("search-overlay");
    const closeBtn = document.getElementById("close-search");

    if (!openBtn || !overlay || !closeBtn) return;

    openBtn.addEventListener("click", () => {
      overlay.classList.remove("hidden");
      setTimeout(() => {
        overlay.querySelector("input")?.focus();
      }, 100);
    });

    closeBtn.addEventListener("click", () => {
      overlay.classList.add("hidden");
    });

    overlay.addEventListener("click", (e) => {
      if (e.target.id === "search-overlay") {
        overlay.classList.add("hidden");
      }
    });
  }

  // 初始加载时绑定
  bindSearchOverlay();

  // View Transition 后重新绑定（document 持久存在，listener 保持存活）
  if (!window.__searchOverlaySwapInit) {
    window.__searchOverlaySwapInit = true;
    document.addEventListener("astro:after-swap", bindSearchOverlay);
  }

  // ESC 关闭 — 全局注册一次
  if (!window.__searchOverlayEscInit) {
    window.__searchOverlayEscInit = true;
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        const overlay = document.getElementById("search-overlay");
        if (overlay && !overlay.classList.contains("hidden")) {
          overlay.classList.add("hidden");
        }
      }
    });
  }
</script>
