---
/* SearchPanel.astro — 搜索面板
 * filter="all"  → Pagefind 搜文章 + 本地匹配标签/合集
 * filter="tags" → 本地匹配标签名，渲染 TagPill 样式
 * filter="sets" → 本地匹配合集名，渲染 SetCard 样式 */

interface Props {
  filter?: "all" | "tags" | "sets";
  tagsJson?: string;   /* JSON: { name: string, count: number }[] */
  setsJson?: string;   /* JSON: { name: string, count: number }[] */
}

const { filter = "all", tagsJson, setsJson } = Astro.props;
---

<div class="search-panel" data-filter={filter}>
  <!-- 搜索输入框 -->
  <div class="relative">
    <svg
      class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted dark:text-muted-dark pointer-events-none"
      viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
    >
      <circle cx="11" cy="11" r="8" />
      <path d="M21 21l-4.35-4.35" />
    </svg>
    <input
      type="text"
      autocomplete="off"
      placeholder={filter === "tags" ? "搜索标签..." : filter === "sets" ? "搜索合集..." : "搜索文章、标签、合集..."}
      class="w-full pl-10 pr-4 py-2.5 rounded-xl border-2 border-border-light dark:border-border-dark bg-white/70 dark:bg-gray-900/70 text-sm text-ink dark:text-ghost placeholder:text-muted dark:placeholder:text-muted-dark focus:outline-none focus:border-accent dark:focus:border-accent transition-colors"
    />
  </div>

  <!-- 搜索结果区域 -->
  <div class="search-results hidden mt-4 space-y-4"></div>

  <!-- 无结果提示 -->
  <p
    class="search-empty hidden text-center text-muted dark:text-muted-dark text-sm py-8"
  >
    未找到相关结果
  </p>

  <!-- 传递服务端标签/合集数据给客户端 JS -->
  {tagsJson ? <script is:inline set:html={`window.__searchTags=${tagsJson};`} /> : null}
  {setsJson ? <script is:inline set:html={`window.__searchSets=${setsJson};`} /> : null}
</div>

<script>
  /* Pagefind 搜索逻辑 */
  interface SearchWindow extends Window {
    __searchInit?: boolean;
    __searchTags?: { name: string; count: number }[];
    __searchSets?: { name: string; count: number }[];
  }
  if (!(window as SearchWindow).__searchInit) {
    (window as SearchWindow).__searchInit = true;

    let pagefind: any = null;
    let debounceTimer: ReturnType<typeof setTimeout>;

    /* ---- Pagefind 加载（仅 filter=all 时使用） ---- */
    async function loadPagefind() {
      if (pagefind) return pagefind;
      try {
        const resp = await fetch("/pagefind/pagefind.js");
        if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
        const code = await resp.text();
        const blob = new Blob([code], { type: "application/javascript" });
        const url = URL.createObjectURL(blob);
        pagefind = await import(url);
        URL.revokeObjectURL(url);
        await pagefind.init();
        return pagefind;
      } catch {
        return null;
      }
    }

    /* ---- 本地匹配 ---- */
    function matchLocal(query: string, items: { name: string; count: number }[]) {
      const q = query.trim().toLowerCase();
      if (!q) return [];
      return items.filter((item) => item.name.toLowerCase().includes(q));
    }

    /* ---- 从 url 提取页面标题 ---- */
    /* ---- 渲染函数 ---- */

    function renderPostItem(item: { url: string; excerpt: string; title?: string }): string {
      const title = item.title || item.url.replace(/\/$/, "").split("/").pop() || "";
      return `
        <a href="${item.url}" class="block px-3 py-2 rounded-lg hover:bg-accent/10 dark:hover:bg-accent/20 transition-colors no-underline">
          <span class="text-sm font-medium text-ink dark:text-ghost block truncate">${title}</span>
          <span class="text-xs text-muted dark:text-muted-dark line-clamp-1 mt-0.5">${item.excerpt}</span>
        </a>`;
    }

    function renderTagPill(t: { name: string; count: number }): string {
      return `
        <a href="/tags/${encodeURIComponent(t.name)}" class="relative inline-flex items-center px-2 py-1 rounded-full border border-border-light dark:border-border-dark text-xs text-muted dark:text-muted-dark hover:border-accent hover:text-accent dark:hover:text-accent transition-colors no-underline">
          ${t.name}
          <span class="absolute -top-1 -right-1 text-[0.55rem] leading-none bg-cream dark:bg-night text-muted dark:text-muted-dark px-1 py-0.5 rounded-full font-medium">${t.count}</span>
        </a>`;
    }

    function renderTagResults(tags: { name: string; count: number }[]): string {
      return `
        <div class="flex flex-wrap gap-2">
          ${tags.map(renderTagPill).join("")}
        </div>`;
    }

    function renderSetCard(s: { name: string; count: number }): string {
      return `
        <a href="/sets/${encodeURIComponent(s.name)}" class="flex items-center justify-between gap-2 px-3 py-2 rounded-lg border-2 border-border-light dark:border-border-dark hover:border-accent dark:hover:border-accent transition-colors no-underline">
          <div class="min-w-0">
            <span class="text-sm font-medium text-ink dark:text-ghost truncate block">${s.name}</span>
            <span class="text-xs text-muted dark:text-muted-dark">${s.count} 篇</span>
          </div>
          <span class="shrink-0 text-muted dark:text-muted-dark text-sm">&rarr;</span>
        </a>`;
    }

    function renderSetResults(sets: { name: string; count: number }[]): string {
      return `
        <div class="space-y-1.5">
          ${sets.map(renderSetCard).join("")}
        </div>`;
    }

    function wrapCategory(label: string, count: number, body: string): string {
      return `
        <div class="search-category">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-muted dark:text-muted-dark mb-2 px-1">${label} · ${count}</h3>
          ${body}
        </div>`;
    }

    /* ---- 切换默认内容与搜索结果间的分割线 ---- */
    /*
     * 改动说明：
     * 原逻辑：有搜索词时隐藏 .search-default-content（全部标签/合集列表）
     * 新逻辑：不再隐藏全部列表，改为在搜索结果与全部列表之间显示一条分割线
     *         panel = .search-panel → parent = 包裹 SearchPanel 的 div
     *         → grandparent = 卡片容器 → 在其内查找 .search-divider 并显隐
     */
    function toggleDefaultContent(panel: HTMLElement, query: string) {
      const grandparent = panel.parentElement?.parentElement;
      if (!grandparent) return;
      const divider = grandparent.querySelector(".search-divider") as HTMLElement | null;
      if (divider) {
        divider.style.display = query ? "" : "none";
      }
    }

    /* ---- 核心搜索函数（接收面板作用域内的元素引用） ---- */
    async function doSearch(
      query: string,
      filter: string,
      resultsEl: HTMLElement,
      emptyEl: HTMLElement,
      panel: HTMLElement,
    ) {
      const tagsData: { name: string; count: number }[] = (window as SearchWindow).__searchTags || [];
      const setsData: { name: string; count: number }[] = (window as SearchWindow).__searchSets || [];

      toggleDefaultContent(panel, query);

      if (!query.trim()) {
        resultsEl.classList.add("hidden");
        resultsEl.innerHTML = "";
        emptyEl.classList.add("hidden");
        return;
      }

      let html = "";

      /* 标签搜索：本地匹配 */
      if (filter === "tags") {
        const matched = matchLocal(query, tagsData);
        if (matched.length) {
          html = wrapCategory("标签", matched.length, renderTagResults(matched));
        }
      }
      /* 合集搜索：本地匹配 */
      else if (filter === "sets") {
        const matched = matchLocal(query, setsData);
        if (matched.length) {
          html = wrapCategory("合集", matched.length, renderSetResults(matched));
        }
      }
      /* 全搜索：Pagefind（文章） + 本地（标签、合集） */
      else {
        /* Pagefind 搜文章 */
        const pf = await loadPagefind();
        if (pf) {
          try {
            const search = await pf.search(query.trim());
            if (search?.results?.length) {
              const raw = await Promise.all(
                search.results.slice(0, 20).map((r: any) => r.data()),
              );
              const posts = raw.filter(
                (r: { url: string }) => r.url.includes("/posts/"),
              );
              const unique = posts.filter(
                (r: { url: string }, i: number, arr: typeof posts) =>
                  arr.findIndex((p) => p.url === r.url) === i,
              );
              if (unique.length) {
                const body = `
                  <div class="space-y-0.5">
                    ${unique.map((r: any) => renderPostItem({ url: r.url, excerpt: r.excerpt, title: r.meta?.title })).join("")}
                  </div>`;
                html += wrapCategory("文章", unique.length, body);
              }
            }
          } catch { /* Pagefind 搜索失败，继续本地匹配 */ }
        }

        /* 本地匹配标签 */
        const matchedTags = matchLocal(query, tagsData);
        if (matchedTags.length) {
          html += wrapCategory("标签", matchedTags.length, renderTagResults(matchedTags));
        }

        /* 本地匹配合集 */
        const matchedSets = matchLocal(query, setsData);
        if (matchedSets.length) {
          html += wrapCategory("合集", matchedSets.length, renderSetResults(matchedSets));
        }
      }

      if (html) {
        resultsEl.innerHTML = html;
        resultsEl.classList.remove("hidden");
        emptyEl.classList.add("hidden");
      } else {
        resultsEl.classList.add("hidden");
        resultsEl.innerHTML = "";
        emptyEl.classList.remove("hidden");
      }
    }

    /* ---- 初始化：为每个 search-panel 绑定独立的事件和元素引用 ---- */
    function init() {
      document.querySelectorAll<HTMLElement>(".search-panel").forEach((panel) => {
        const input = panel.querySelector("input");
        const filter = panel.dataset.filter || "all";
        if (!input || input.dataset.searchBound) return;
        input.dataset.searchBound = "1";

        /* 作用域限定的结果/空态元素 */
        const resultsEl = panel.querySelector(".search-results") as HTMLElement | null;
        const emptyEl = panel.querySelector(".search-empty") as HTMLElement | null;
        if (!resultsEl || !emptyEl) return;

        input.addEventListener("input", () => {
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(() => doSearch(input.value, filter, resultsEl, emptyEl, panel), 200);
        });
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  }
</script>
