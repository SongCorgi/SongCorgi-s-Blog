---
/* TagPill.astro — 紧凑标签 pill，标签名 + 右上角微小计数，点击跳转 /tags/[tag] */

interface Props {
  tag: string;   /* 标签名称 */
  count: number; /* 该标签下的文章数量 */
}

const { tag, count } = Astro.props;
---

<a
  href={`/tags/${encodeURIComponent(tag)}`}
  class="relative inline-flex items-center px-2 py-1 rounded-full border border-border-light dark:border-border-dark text-xs text-ink dark:text-ghost hover:border-accent hover:text-accent dark:hover:text-accent transition-colors no-underline break-words"
>
  {tag}
  <span
    class="absolute -top-1 -right-1 text-[0.55rem] leading-none bg-cream dark:bg-night text-ink dark:text-ghost px-1 py-0.5 rounded-full font-medium"
  >
    {count}
  </span>
</a>
