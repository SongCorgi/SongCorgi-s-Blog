---
/* SetCard.astro — 合集卡片，展示合集名称、文章数量与跳转箭头 */

interface Props {
  name: string;   /* 合集名称 */
  count: number;  /* 合集内的文章数量 */
}

const { name, count } = Astro.props;
---

<a
  href={`/sets/${encodeURIComponent(name)}`}
  class="set-card-link flex items-center gap-2 px-3 py-2 rounded-lg border-2 hover:border-accent dark:hover:border-accent transition-colors no-underline group"
>
  <div class="min-w-0">
    <span
      class="text-sm font-medium text-ink dark:text-ghost group-hover:text-accent dark:group-hover:text-accent transition-colors whitespace-normal break-words"
    >
      {name}
    </span>
    <span class="text-xs text-ink dark:text-ghost block mt-0.5">{count} 篇</span>
  </div>
</a>

<style is:global>
  .set-card-link {
    border-color: #E0CEB5;
    background-color: #FBF5ED;
  }
  .dark .set-card-link {
    border-color: #7A5038;
    background-color: #5C361E;
  }
</style>
