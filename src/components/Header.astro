---
/* ============================================================
 * Header.astro — 全局顶部导航栏
 * 左侧展示站点标题，右侧展示导航链接与主题切换按钮
 * 根据当前页面路径高亮活跃链接
 * ============================================================ */

/* 获取当前页面路径，用于判断哪个导航项处于活跃状态 */
const currentPath = Astro.url.pathname;

/* 导航项定义：路径 -> 显示文本，从左到右排列 */
const navItems = [
  { path: "/",               label: "首页" },
  { path: "/blog",           label: "博客" },
  { path: "/projectDisplay",  label: "项目" },
  { path: "/about",          label: "关于" },
];

/* 判断给定路径是否为当前活跃页面 */
function isActive(navPath: string): boolean {
  /* 首页精确匹配根路径，避免误匹配所有以 / 开头的路径 */
  if (navPath === "/") return currentPath === "/";
  /* 子页面匹配路径前缀（如 /blog/hello-world 也匹配 /blog） */
  return currentPath.startsWith(navPath);
}
---

<header
  id="site-header"
  transition:persist="header"
  class="header-main fixed top-2 left-1/2 z-50 w-[calc(100%-1rem)] max-w-[88rem] bg-[#f0f4f3] dark:bg-[#0a0f14] px-4 sm:px-6 py-6 flex items-center justify-between gap-4 rounded-2xl transition-[box-shadow,top,max-width,padding,transform] duration-350"
  style="transform: translate(-50%, 0); view-transition-name: header"
>
  {/* 站点标题 — 点击返回首页，使用无衬线粗体 */}
  <a
    href="/"
    class="header-title text-xl sm:text-2xl font-bold tracking-tight no-underline text-ink dark:text-ghost hover:opacity-80 transition-opacity"
  >
    SongCorgi's Blog
  </a>

  {/* 导航链接 + 主题切换按钮，始终横向排列 */}
  <div class="flex items-center gap-2 sm:gap-6 flex-wrap justify-end">
    {/* 导航链接列表 */}
    <nav class="header-nav flex items-center gap-4 sm:gap-6">
      {
        navItems.map((item) => {
          /* 根据是否活跃页面使用不同的样式组合 */
          const linkClass = isActive(item.path)
            ? "text-accent font-medium"                                               /* 活跃页面：高亮色 + 中等粗细 */
            : "text-muted dark:text-muted-dark hover:text-accent dark:hover:text-accent"; /* 非活跃页面：灰色 + hover 变高亮色 */

          return (
            <a
              href={item.path}
              class={`text-sm sm:text-base transition-colors duration-200 no-underline ${linkClass}`}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    {/* 主题切换：三态循环（浅色 → 跟随系统 → 深色） */}
    <button
      id="theme-toggle"
      class="theme-toggle-btn w-9 h-9 rounded-full flex items-center justify-center transition-colors duration-300 bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 cursor-pointer border-0 p-0 shrink-0"
      aria-label="切换主题"
    >
      <svg id="icon-sun" class="w-4 h-4 pointer-events-none text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
      </svg>
      <svg id="icon-system" class="w-4 h-4 pointer-events-none hidden text-gray-500 dark:text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>
      </svg>
      <svg id="icon-moon" class="w-4 h-4 pointer-events-none hidden text-indigo-400" viewBox="0 0 24 24" fill="currentColor">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
    </button>
  </div>
</header>

{/* 导航栏滚动动画样式 — 仅保留 Tailwind 无法表达的动态部分 */}
<style>
  .header-main {
    view-transition-name: header;
  }

  /* 紧凑悬浮胶囊 */
  .header-main.compact {
    top: 0.75rem;
    max-width: 70rem;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
    border-radius: 9999px;
    background: #f4f4f5;
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.07);
  }

  :global(.dark) .header-main.compact {
    background: #051f33;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.5);
    border: 0.5px solid rgba(255, 255, 255, 0.1);
  }
</style>

{/* 客户端脚本 — 处理主题切换交互 */}
<script>
  function setupThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    const iconSun = document.getElementById('icon-sun');
    const iconSystem = document.getElementById('icon-system');
    const iconMoon = document.getElementById('icon-moon');

    const states = ['light', 'system', 'dark'];
    const icons = { light: iconSun, system: iconSystem, dark: iconMoon };

    function getTheme() {
      return localStorage.getItem('theme') || 'system';
    }

    function isDark() {
      const theme = getTheme();
      if (theme === 'dark') return true;
      if (theme === 'light') return false;
      return matchMedia('(prefers-color-scheme: dark)').matches;
    }

    function applyTheme() {
      if (isDark()) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    }

    function updateIcon() {
      var current = getTheme();
      var userPicked = localStorage.getItem('themeSet') === '1';
      if (!userPicked && (current === 'system' || !current)) {
        current = isDark() ? 'dark' : 'light';
      }
      Object.values(icons).forEach(function(el) { if (el) el.classList.add('hidden'); });
      if (icons[current]) icons[current].classList.remove('hidden');
    }

    btn.addEventListener('click', function() {
      localStorage.setItem('themeSet', '1');
      const current = getTheme();
      const idx = states.indexOf(current);
      const next = states[(idx + 1) % 3];
      localStorage.setItem('theme', next);
      applyTheme();
      updateIcon();
    });

    applyTheme();
    updateIcon();

    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function() {
      if (getTheme() === 'system') { applyTheme(); updateIcon(); }
    });
  }

  setupThemeToggle();

  /* 导航栏滚动动画 — 上滑出现、下滑滑出，位置跟随滚动 */
  (function() {
    const header = document.getElementById('site-header') as HTMLElement | null;
    if (!header) return;
    const el = header;

    const SHRINK = 40;       // 超过此值 → 缩为胶囊
    const HIDE_START = 300;  // 开始滑出
    const HIDE_RANGE = 100;  // 滑出过渡区间
    let lastScrollY = window.scrollY;
    let ticking = false;

    function update() {
      const y = window.scrollY;

      if (y < SHRINK) {
        el.style.transform = 'translate(-50%, 0)';
        el.classList.remove('compact');
      } else {
        el.classList.add('compact');

        if (y < lastScrollY) {
          // 向上滚动 → 胶囊立即出现
          el.style.transform = 'translate(-50%, 0)';
        } else if (y >= HIDE_START) {
          // 向下滚动 + 超过阈值 → 按滚动位置滑出
          const t = Math.min((y - HIDE_START) / HIDE_RANGE, 1);
          el.style.transform = `translate(-50%, ${-6 * t}rem)`;
        } else {
          // 向下滚动但未到阈值 → 胶囊保持可见
          el.style.transform = 'translate(-50%, 0)';
        }
      }

      lastScrollY = y;
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }, { passive: true });
  })();

  /* ClientRouter 导航后更新活跃链接高亮 — Header 因 transition:persist 保留在 DOM 中 */
  function updateActiveNav() {
    const path = window.location.pathname;
    const nav = document.querySelector('.header-nav');
    if (!nav) return;
    nav.querySelectorAll('a').forEach((link) => {
      const href = link.getAttribute('href');
      if (href == null) return;
      const isActive = href === '/' ? path === '/' : path.startsWith(href);
      if (isActive) {
        link.classList.add('text-accent', 'font-medium');
        link.classList.remove('text-muted', 'dark:text-muted-dark', 'hover:text-accent', 'dark:hover:text-accent');
      } else {
        link.classList.remove('text-accent', 'font-medium');
        link.classList.add('text-muted', 'dark:text-muted-dark', 'hover:text-accent', 'dark:hover:text-accent');
      }
    });
  }

  updateActiveNav();
  document.addEventListener('astro:after-swap', updateActiveNav);

  /* ClientRouter 导航后恢复主题 — swapRootAttributes 会用新页面 html class 覆盖当前值 */
  function restoreTheme() {
    const saved = localStorage.getItem('theme');
    if (saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  }
  restoreTheme();
  document.addEventListener('astro:after-swap', restoreTheme);

  /* 页面跳转时冻结主题切换按钮动画，避免 dark class 短暂移除时触发滑动 */
  function freezeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.style.transition = 'none';
    const knob = btn.querySelector('span:last-child') as HTMLElement | null;
    if (knob) knob.style.transition = 'none';
  }
  function unfreezeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    requestAnimationFrame(() => {
      btn.style.transition = '';
      const knob = btn.querySelector('span:last-child') as HTMLElement | null;
      if (knob) knob.style.transition = '';
    });
  }
  document.addEventListener('astro:before-swap', freezeToggle);
  document.addEventListener('astro:after-swap', unfreezeToggle);
</script>
