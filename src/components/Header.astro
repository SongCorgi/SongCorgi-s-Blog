---
/* ============================================================
 * Header.astro — 全局顶部导航栏
 * 左侧展示站点标题，右侧展示导航链接与主题切换按钮
 * 根据当前页面路径高亮活跃链接
 * ============================================================ */

/* 获取当前页面路径，用于判断哪个导航项处于活跃状态 */
const currentPath = Astro.url.pathname;

/* 导航项定义：路径 -> 显示文本，从左到右排列 */
const navItems = [
  { path: "/",               label: "首页" },
  { path: "/blog",           label: "博客" },
  { path: "/about",          label: "关于" },
];

/* 判断给定路径是否为当前活跃页面 */
function isActive(navPath: string): boolean {
  /* 首页精确匹配根路径，避免误匹配所有以 / 开头的路径 */
  if (navPath === "/") return currentPath === "/";
  /* 子页面匹配路径前缀（如 /blog/hello-world 也匹配 /blog） */
  return currentPath.startsWith(navPath);
}
---

<header
  id="site-header"
  class="header-main w-full max-w-3xl mx-auto px-4 sm:px-6 py-6 flex items-center justify-between gap-4"
>
  {/* 站点标题 — 点击返回首页，使用无衬线粗体 */}
  <a
    href="/"
    class="header-title text-xl sm:text-2xl font-bold tracking-tight no-underline text-ink dark:text-ghost hover:opacity-80 transition-opacity"
  >
    CleanBlog
  </a>

  {/* 导航链接 + 主题切换按钮，始终横向排列 */}
  <div class="flex items-center gap-2 sm:gap-6 flex-wrap justify-end">
    {/* 导航链接列表 */}
    <nav class="header-nav flex items-center gap-4 sm:gap-6">
      {
        navItems.map((item) => {
          /* 根据是否活跃页面使用不同的样式组合 */
          const linkClass = isActive(item.path)
            ? "text-accent font-medium"                                               /* 活跃页面：高亮色 + 中等粗细 */
            : "text-muted dark:text-muted-dark hover:text-accent dark:hover:text-accent"; /* 非活跃页面：灰色 + hover 变高亮色 */

          return (
            <a
              href={item.path}
              class={`text-sm sm:text-base transition-colors duration-200 no-underline ${linkClass}`}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    {/* 主题切换：iOS 风格胶囊滑动开关，轨道内嵌日月图标 */}
    <button
      id="theme-toggle"
      class="theme-toggle-btn relative w-11 h-6 rounded-full transition-colors duration-300 bg-gray-300 dark:bg-accent cursor-pointer border-0 p-0 shrink-0"
      aria-label="切换亮色/暗色主题"
    >
      {/* 轨道左侧太阳图标 */}
      <svg
        class="absolute left-[3px] top-1/2 -translate-y-1/2 w-3 h-3 pointer-events-none text-amber-500"
        viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
      >
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
      </svg>
      {/* 轨道右侧月亮图标 */}
      <svg
        class="absolute right-[3px] top-1/2 -translate-y-1/2 w-3 h-3 pointer-events-none text-white/70"
        viewBox="0 0 24 24" fill="currentColor"
      >
        <path d="M20.74 13.95A8.5 8.5 0 0 1 9.5 3.05a7 7 0 1 0 11.24 10.9z" />
      </svg>
      {/* 滑动圆钮 */}
      <span
        class="absolute top-0.5 left-0.5 w-5 h-5 rounded-full bg-white shadow-sm transition-transform duration-300 dark:translate-x-5"
      ></span>
    </button>
  </div>
</header>

{/* 导航栏滚动动画样式 */}
<style>
  /* === 始终 fixed 定位 === */
  .header-main {
    position: fixed;
    top: 0;
    left: 50%;
    transform: translate(-50%, 0);
    z-index: 50;
    width: 100%;
    max-width: 48rem; /* max-w-3xl */
    background: #e4f3ed;
    transition: background-color 0.35s ease,
                box-shadow 0.35s ease,
                border-radius 0.35s ease,
                top 0.35s ease,
                max-width 0.28s ease,
                padding 0.35s ease,
                transform 0.15s linear;
  }

  /* === 紧凑悬浮胶囊 — 略窄、略矮、与顶部留间距 === */
  .header-main.compact {
    top: 0.75rem;
    max-width: 28rem;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
    border-radius: 9999px;
    background: #f4f4f5;
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.07);
  }

  /* === 暗色模式 === */
  .dark .header-main {
    background: #0f172a;
  }
  .dark .header-main.compact {
    background: #1e293b;
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.35);
  }
</style>

{/* 客户端脚本 — 处理主题切换交互 */}
<script>
  function setupThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    function getTheme(): 'dark' | 'light' {
      return document.documentElement.classList.contains('dark') ? 'dark' : 'light';
    }

    function setTheme(theme: 'dark' | 'light') {
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      localStorage.setItem('theme', theme);
    }

    btn.addEventListener('click', () => {
      setTheme(getTheme() === 'dark' ? 'light' : 'dark');
    });
  }

  setupThemeToggle();

  /* 导航栏滚动动画 — 上滑出现、下滑滑出，位置跟随滚动 */
  (function() {
    const header = document.getElementById('site-header') as HTMLElement | null;
    if (!header) return;
    const el = header;

    const SHRINK = 40;       // 超过此值 → 缩为胶囊
    const HIDE_START = 300;  // 开始滑出
    const HIDE_RANGE = 100;  // 滑出过渡区间
    let lastScrollY = window.scrollY;
    let ticking = false;

    function update() {
      const y = window.scrollY;

      if (y < SHRINK) {
        el.style.transform = '';
        el.classList.remove('compact');
      } else {
        el.classList.add('compact');

        if (y < lastScrollY) {
          // 向上滚动 → 胶囊立即出现
          el.style.transform = 'translate(-50%, 0)';
        } else if (y >= HIDE_START) {
          // 向下滚动 + 超过阈值 → 按滚动位置滑出
          const t = Math.min((y - HIDE_START) / HIDE_RANGE, 1);
          el.style.transform = `translate(-50%, ${-6 * t}rem)`;
        } else {
          // 向下滚动但未到阈值 → 胶囊保持可见
          el.style.transform = 'translate(-50%, 0)';
        }
      }

      lastScrollY = y;
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }, { passive: true });
  })();
</script>
