---
/* GiscusComments.astro — 基于 GitHub Discussions 的评论系统 */
---

<div class="giscus-container mt-12 pt-8 border-t border-border-light dark:border-border-dark"></div>

<script data-astro-rerun>
  const giscusLightTheme = window.location.origin + '/giscus/light.css';
  const giscusDarkTheme = window.location.origin + '/giscus/dark.css';

  function injectGiscus() {
    const containers = document.querySelectorAll('.giscus-container');
    const container = Array.from(containers).find(c => c.checkVisibility()) || containers[0];
    if (!container || container.querySelector('iframe.giscus-frame')) return;

    const script = document.createElement('script');
    script.src = 'https://giscus.app/client.js';
    script.setAttribute('data-repo', 'SongCorgi/SongCorgi-s-Blog');
    script.setAttribute('data-repo-id', 'R_kgDOSpGhSA');
    script.setAttribute('data-category', 'Announcements');
    script.setAttribute('data-category-id', 'DIC_kwDOSpGhSM4C9789');
    script.setAttribute('data-mapping', 'pathname');
    script.setAttribute('data-strict', '0');
    script.setAttribute('data-reactions-enabled', '1');
    script.setAttribute('data-emit-metadata', '1');
    script.setAttribute('data-input-position', 'top');
    script.setAttribute('data-lang', 'zh-CN');
    script.setAttribute('data-loading', 'lazy');
    script.setAttribute('data-theme', document.documentElement.classList.contains('dark') ? giscusDarkTheme : giscusLightTheme);
    script.crossOrigin = 'anonymous';
    script.async = true;
    container.appendChild(script);
  }

  injectGiscus();

  /* 主题切换：通过 postMessage 同步到 giscus iframe */
  function sendGiscusTheme() {
    const isDark = document.documentElement.classList.contains('dark');
    const iframe = document.querySelector('iframe.giscus-frame');
    if (iframe?.contentWindow) {
      iframe.contentWindow.postMessage(
        { giscus: { setConfig: { theme: isDark ? giscusDarkTheme : giscusLightTheme } } },
        'https://giscus.app'
      );
    }
  }

  const giscusObserver = new MutationObserver(sendGiscusTheme);
  giscusObserver.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['class'],
  });

  /* 初始加载 / ClientRouter 导航后强制恢复 giscus 主题 */
  function restoreGiscusTheme() {
    const saved = localStorage.getItem('theme');
    const isDark = saved === 'dark' || (saved !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
    const theme = isDark ? giscusDarkTheme : giscusLightTheme;
    document.querySelectorAll('iframe[src*="giscus"]').forEach((iframe) => {
      const src = iframe.getAttribute('src');
      if (src) {
        try {
          const url = new URL(src);
          url.searchParams.set('theme', theme);
          iframe.setAttribute('src', url.toString());
        } catch(e) {}
      }
    });
  }

  restoreGiscusTheme();
  document.addEventListener('astro:after-swap', restoreGiscusTheme);

  /* 主题切换按钮点击时立即同步 */
  function syncGiscusTheme() {
    const isDark = document.documentElement.classList.contains('dark');
    const theme = isDark ? giscusDarkTheme : giscusLightTheme;
    document.querySelectorAll('iframe[src*="giscus"]').forEach((iframe) => {
      const src = iframe.getAttribute('src');
      if (src) {
        try {
          const url = new URL(src);
          url.searchParams.set('theme', theme);
          iframe.setAttribute('src', url.toString());
        } catch(e) {}
      }
    });
  }

  const themeToggle = document.getElementById('theme-toggle');
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      setTimeout(syncGiscusTheme, 100);
    });
  }

  /* 清理 */
  document.addEventListener('astro:before-swap', () => {
    giscusObserver.disconnect();
  }, { once: true });
</script>
