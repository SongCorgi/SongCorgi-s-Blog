---
/* ============================================================
 * BaseLayout.astro — 全站基础布局组件
 * 提供统一的 HTML 骨架，包含 SEO 元标签、Header、Main、Footer
 * 每个页面通过 <slot /> 注入各自的定制内容
 * ============================================================ */

/* 引入全局样式（Tailwind + 字体 + 主题配置）— Astro 会自动打包优化 */
import "../styles/global.css";

/* 引入 ClientRouter 实现页面过渡动画 */
import { ClientRouter } from "astro:transitions";

/* 引入 Header 与 Footer 组件 */
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

/* Props 接口定义 — 每个页面必须传入标题和描述 */
interface Props {
  title: string;       /* 页面标题，用于 <title> 和 og:title */
  description: string; /* 页面描述，用于 <meta name="description"> 和 og:description */
  ogImage?: string;    /* 可选的 Open Graph 社交分享图片 URL */
}

/* 解构 Props，ogImage 提供默认值 */
const { title, description, ogImage = "/favicon.svg" } = Astro.props;

/* 站点基础 URL — 后续部署时替换为实际域名 */
const siteURL = "https://songcorgi.dev";
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    {/* 防闪烁脚本 — 在 CSS 加载前应用暗色模式，避免页面闪烁 */}
    <script is:inline>
      (function() {
        const t = localStorage.getItem('theme');                                     /* 读取用户手动选择的主题 */
        if (t === 'dark' || (t !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');                            /* 无记录时回退到系统偏好 */
        }
      })();
    </script>

    {/* ———— 基础元标签 ———— */}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    {/* ClientRouter — 启用 SPA 式页面过渡动画 */}
    <ClientRouter />

    {/* ———— 页面标题与描述 ———— */}
    <title>{title} | SongCorgi's Blog</title>
    <meta name="description" content={description} />

    {/* ———— Open Graph（社交分享卡片） ———— */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, siteURL).href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="SongCorgi's Blog" />

    {/* ———— favicon 图标 ———— */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    {/* ———— 消除页面切换白屏闪烁 ———— */}
    <style is:inline>
      html {
        background-color: #f0f4f3;
      }
      html.dark {
        background-color: #0f172a;
      }
    </style>
  </head>

  <body
    class="flex flex-col min-h-screen text-ink dark:text-ghost"
    style="background-color: var(--bg-color)"
  >
    {/* Fix: View Transition 期间 DOM 脚本插入被浏览器抑制，用间接 eval 替代 */}
    <script is:inline>
      (function() {
        if (window.__astro_eval_fix) return;
        window.__astro_eval_fix = true;

        const origReplaceWith = HTMLScriptElement.prototype.replaceWith;
        HTMLScriptElement.prototype.replaceWith = function(...args) {
          const newScript = args[0];
          if (
            newScript instanceof HTMLScriptElement &&
            !this.hasAttribute('src') &&
            this.getAttribute('type') !== 'module' &&
            this.textContent
          ) {
            try { (0, eval)(this.textContent); } catch(e) {}
            this.remove();
            return;
          }
          return origReplaceWith.apply(this, args);
        };
      })();
    </script>

    {/* 顶部导航栏 */}
    <Header />

    {/* 主内容区 — flex-1 使其填充剩余空间，确保 footer 始终在底部 */}
    <main class="flex-1 w-full max-w-3xl mx-auto px-4 sm:px-6 pt-[4.5rem] pb-8">
      <slot />
    </main>

    {/* 底部页脚 */}
    <Footer />

    {/* 滚动驱动背景色脚本 — 页面顶部浅青色，下滑渐变至近乎白 */}
    <script data-astro-rerun>
      (function() {
        function update() {
          const isDark = document.documentElement.classList.contains('dark');
          document.documentElement.style.setProperty('--bg-color', isDark ? 'rgb(10, 15, 20)' : 'rgb(240, 244, 243)');
        }
        update();
        new MutationObserver(update).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['class'],
        });
      })();
    </script>

    {/* 导航后滚动到页面顶部（浏览器后退/前进时不滚动） */}
    <script data-astro-rerun>
      let _vtIsPopState = false;
      window.addEventListener('popstate', () => { _vtIsPopState = true; });
      document.addEventListener('astro:after-swap', () => {
        if (!_vtIsPopState) {
          window.scrollTo({ top: 0, behavior: 'instant' });
        }
        _vtIsPopState = false;
      });
    </script>
  </body>
</html>
