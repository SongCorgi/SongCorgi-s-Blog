---
/* ============================================================
 * BaseLayout.astro — 全站基础布局组件
 * 提供统一的 HTML 骨架，包含 SEO 元标签、Header、Main、Footer
 * 每个页面通过 <slot /> 注入各自的定制内容
 * ============================================================ */

/* 引入全局样式（Tailwind + 字体 + 主题配置）— Astro 会自动打包优化 */
import "../styles/global.css";

/* 引入 Header 与 Footer 组件 */
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

/* Props 接口定义 — 每个页面必须传入标题和描述 */
interface Props {
  title: string;       /* 页面标题，用于 <title> 和 og:title */
  description: string; /* 页面描述，用于 <meta name="description"> 和 og:description */
  ogImage?: string;    /* 可选的 Open Graph 社交分享图片 URL */
}

/* 解构 Props，ogImage 提供默认值 */
const { title, description, ogImage = "/favicon.svg" } = Astro.props;

/* 站点基础 URL — 后续部署时替换为实际域名 */
const siteURL = "https://cleanblog.dev";
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    {/* 防闪烁脚本 — 在 CSS 加载前应用暗色模式，避免页面闪烁 */}
    <script is:inline>
      (function() {
        const t = localStorage.getItem('theme');                                     /* 读取用户手动选择的主题 */
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');                            /* 无记录时回退到系统偏好 */
        }
      })();
    </script>

    {/* ———— 基础元标签 ———— */}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    {/* ———— 页面标题与描述 ———— */}
    <title>{title} | CleanBlog</title>
    <meta name="description" content={description} />

    {/* ———— Open Graph（社交分享卡片） ———— */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, siteURL).href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="CleanBlog" />

    {/* ———— favicon 图标 ———— */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    {/* ———— 消除页面切换白屏闪烁 ———— */}
    <style is:inline>
      html {
        background-color: #e4f3ed;
      }
      html.dark {
        background-color: #0f172a;
      }
    </style>
  </head>

  <body
    class="flex flex-col min-h-screen text-ink dark:text-ghost"
    style="background-color: var(--bg-color)"
  >
    {/* 顶部导航栏 */}
    <Header />

    {/* 主内容区 — flex-1 使其填充剩余空间，确保 footer 始终在底部 */}
    <main class="flex-1 w-full max-w-3xl mx-auto px-4 sm:px-6 pt-[4.5rem] pb-8">
      <slot />
    </main>

    {/* 底部页脚 */}
    <Footer />

    {/* 滚动驱动背景色脚本 — 页面顶部浅青色，下滑渐变至近乎白 */}
    <script>
      (function() {
        const MAX_SCROLL = 800;  /* 滚动到此距离后颜色不再变化（更平缓过渡） */

        /* 亮色模式：浅青偏绿 → 浅灰带青 */
        const LIGHT_START = { r: 228, g: 243, b: 237 };  /* #e4f3ed 浅薄荷青，更浅偏绿 */
        const LIGHT_END   = { r: 240, g: 244, b: 243 };  /* #f0f4f3 浅灰带微青 */

        /* 暗色模式：藏蓝 → 纯黑 */
        const DARK_START  = { r: 15, g: 23, b: 42 };      /* #0f172a 藏蓝（顶部） */
        const DARK_END    = { r: 10, g: 15, b: 20 };      /* #0a0f14 纯黑（下滑后） */

        function lerp(a: number, b: number, t: number): number { return Math.round(a + (b - a) * t); }

        function update() {
          const isDark = document.documentElement.classList.contains('dark');
          const start = isDark ? DARK_START : LIGHT_START;
          const end   = isDark ? DARK_END   : LIGHT_END;
          const t = Math.min(window.scrollY / MAX_SCROLL, 1);
          const r = lerp(start.r, end.r, t);
          const g = lerp(start.g, end.g, t);
          const b = lerp(start.b, end.b, t);
          document.documentElement.style.setProperty('--bg-color', `rgb(${r}, ${g}, ${b})`);
        }

        /* 首屏初始化 */
        update();

        /* 监听滚动，passive 提升性能 */
        window.addEventListener('scroll', update, { passive: true });

        /* 主题切换时重新计算 */
        new MutationObserver(update).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['class'],
        });
      })();
    </script>
  </body>
</html>
