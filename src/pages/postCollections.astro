---
/* ============================================================
 * postCollections.astro — 合集页
 * 使用 BaseLayout 包裹，展示按系列组织的文章合集
 * ============================================================ */

import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="合集"
  description="按系列浏览文章合集，系统化学习与阅读。"
>
  <section class="py-16 text-center">
    <h1 class="text-4xl sm:text-5xl font-bold mb-4 text-ink dark:text-ghost">
      合集
    </h1>
    <p class="text-lg text-muted dark:text-muted-dark max-w-xl mx-auto leading-relaxed">
      文章合集即将上线，敬请期待。
    </p>
  </section>
</BaseLayout>
