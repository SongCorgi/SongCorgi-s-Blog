---
/* archive.astro — 文章归档页，按年份→月份时间轴展示所有文章 */

import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getWordCount, groupPostsByYearMonth } from "../utils/post";

/* 获取所有文章，按发布日期降序排列 */
const allPosts = await getCollection("posts");
allPosts.sort((a, b) => b.data.published.getTime() - a.data.published.getTime());

/* 按 年份 → 月份 分组，年份降序、月份降序 */
const yearGroups = groupPostsByYearMonth(allPosts);
const totalCount = allPosts.length;
---

<BaseLayout
  title="归档"
  description="按时间线浏览所有博客文章。"
>
  <section class="py-8">
    <!-- 页面标题 -->
    <h1 class="text-4xl sm:text-5xl font-bold mb-4 text-center text-ink dark:text-ghost">
      归档
    </h1>
    <p
      class="text-lg text-muted dark:text-muted-dark max-w-xl mx-auto mb-8 text-center leading-relaxed"
    >
      共 {totalCount} 篇文章
    </p>

    <!-- 时间轴内容 -->
    {
      yearGroups.length > 0 ? (
        yearGroups.map((yearGroup) => (
          <div class="mt-10 first:mt-0">
            <!-- 年份标题 + 水平装饰线 -->
            <h2
              class="flex items-center gap-4 mb-6 text-2xl sm:text-3xl font-bold font-serif text-accent"
            >
              {yearGroup.year}
              <span
                class="flex-1 h-px bg-border-light dark:bg-border-dark"
              ></span>
            </h2>

            <!-- 月份组：border-l 创建垂直时间轴线 -->
            <div
              class="ml-2 sm:ml-4 border-l-2 border-border-light dark:border-border-dark"
            >
              {yearGroup.months.map((monthGroup) => (
                <!-- 每一月：flex 行，dot 与内容左右放置 -->
                <div class="flex items-start gap-x-3 sm:gap-x-4 pb-6 last:pb-0">
                  <!-- 时间轴 dot：负 margin 拉回到 border 线上方，ring 遮盖穿过的线 -->
                  <div class="shrink-0 -ml-[6px] mt-[0.5rem] sm:mt-[0.55rem]">
                    <div
                      class="w-2.5 h-2.5 rounded-full bg-accent ring-2 ring-cream dark:ring-night"
                    ></div>
                  </div>

                  <!-- 月份内容区 -->
                  <div class="flex-1 min-w-0">
                    <!-- 月份标签 -->
                    <h3
                      class="text-lg font-semibold font-serif text-ink dark:text-ghost mb-3"
                    >
                      {monthGroup.month}月
                    </h3>

                    <!-- 该月下的文章列表 -->
                    <div class="space-y-4">
                      {monthGroup.posts.map((post) => (
                        <ArticleCard
                          title={post.title}
                          description={post.description}
                          published={post.published}
                          updated={post.updated}
                          tags={post.tags}
                          wordCount={getWordCount(post.body)}
                          slug={post.slug}
                        />
                      ))}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))
      ) : (
        <p class="text-center text-muted dark:text-muted-dark py-16">暂无文章</p>
      )
    }
  </section>
</BaseLayout>
