---
/* [slug].astro — 文章阅读页，右侧悬浮操作按钮 + 左侧可展开面板 */

import { getCollection, getEntry, render } from "astro:content";
import { formatDate, getSets } from "../../utils/post";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GiscusComments from "../../components/GiscusComments.astro";
import "katex/dist/katex.min.css";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((p) => ({ params: { slug: p.id } }));
}

const { slug } = Astro.params;
const entry = await getEntry("posts", slug!);

if (!entry) {
  return new Response("文章未找到", { status: 404 });
}

const { Content, headings } = await render(entry);

/* ---- 合集数据 ---- */
const allPosts = await getCollection("posts");
const sets = getSets(allPosts);
const currentSet = sets.find(s => s.name === entry.data.belongToSet);
const setPosts = currentSet?.posts.sort((a, b) =>
  a.published.getTime() - b.published.getTime()
) ?? [];
const currentSetIndex = setPosts.findIndex(p => p.slug === slug);

/* ---- 上下篇（按发表时间升序，取邻篇） ---- */
const allPostsSorted = allPosts.sort((a, b) =>
  a.data.published.getTime() - b.data.published.getTime()
);
const allIdx = allPostsSorted.findIndex(p => p.id === slug);
const prevPost = allIdx > 0 ? allPostsSorted[allIdx - 1] : null;
const nextPost = allIdx < allPostsSorted.length - 1 ? allPostsSorted[allIdx + 1] : null;

/* ---- 首个标签 ---- */
const firstTag = entry.data.tags?.[0] ?? null;

/* ---- 构建大纲树形结构 ---- */
interface TocNode {
  depth: number;
  slug: string;
  text: string;
  children: TocNode[];
}

function buildTocTree(items: typeof headings): TocNode[] {
  const root: TocNode[] = [];
  const stack: TocNode[] = [];
  for (const h of items) {
    const node: TocNode = { depth: h.depth, slug: h.slug, text: h.text, children: [] };
    while (stack.length > 0 && stack[stack.length - 1].depth >= h.depth) {
      stack.pop();
    }
    if (stack.length === 0) {
      root.push(node);
    } else {
      stack[stack.length - 1].children.push(node);
    }
    stack.push(node);
  }
  return root;
}

const tocTree = buildTocTree(headings);

/* ---- 递归渲染大纲 HTML ---- */
function getIndentStyle(depth: number): string {
  const base = 12;
  const extra = (depth - 2) * 16;
  return `padding-left: ${base + extra}px`;
}

function getSizeClass(depth: number): string {
  if (depth <= 2) return "text-sm";
  if (depth <= 4) return "text-xs";
  return "text-[0.65rem]";
}

function renderToc(nodes: TocNode[]): string {
  if (!nodes.length) return "";

  function flatten(list: TocNode[], result: TocNode[] = []): TocNode[] {
    for (const n of list) {
      result.push(n);
      if (n.children.length > 0) flatten(n.children, result);
    }
    return result;
  }
  const flat = flatten(nodes);

  let h = '<div class="toc-list">';
  for (const node of flat) {
    h += '<div class="toc-row">';
    h += `<span class="toc-progress" style="display:block;width:2px;border-radius:9999px;height:0.9rem">`;
    h += `<span class="toc-progress-fill" data-progress-for="${node.slug}" style="display:block;height:0%;border-radius:9999px;background:var(--color-accent)"></span>`;
    h += `</span>`;
    h +=
      `<a href="#${node.slug}" data-toc-link="${node.slug}" style="${getIndentStyle(node.depth)}" class="${getSizeClass(node.depth)} block truncate transition-colors no-underline hover:text-accent text-black dark:text-ghost">${node.text}</a>`;
    h += "</div>";
  }
  h += "</div>";
  return h;
}

const tocHtml = headings.length > 0 ? renderToc(tocTree) : "";

/* ---- 辅助：生成合集面板的文章列表 HTML ---- */
function renderSetList(): string {
  if (!setPosts.length) return "";
  let h = "";
  for (const sp of setPosts) {
    const isCurrent = sp.slug === slug;
    h += `<a href="/posts/${sp.slug}" class="set-link block truncate text-sm transition-colors no-underline py-0.5 ${
      isCurrent
        ? "text-accent font-medium bg-accent/10 rounded px-2 -mx-2"
        : "text-black dark:text-ghost hover:text-accent"
    }" title="${sp.title}">${sp.title}</a>`;
  }
  return h;
}
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage="/favicon.svg"
>
  <!-- 关键 CSS 内联：保证 ClientRouter 导航时这些规则已生效 -->
  <style is:inline>
    main { max-width: 90rem }
    #post-layout {
      width: fit-content;
      max-width: 100%;
      margin-left: auto;
      margin-right: auto;
      padding-top: 4.5rem;
    }
    #article-wrap {
      width: 64rem;
      flex-shrink: 0;
    }
    #article-content {
      width: 52rem;
      max-width: 52rem;
      min-width: 0;
      margin-left: 6rem;
      margin-right: 6rem;
      transition: width 0.28s ease, max-width 0.28s ease, margin-left 0.28s ease, margin-right 0.28s ease;
    }
    #article-content.narrowed {
      width: 43rem;
      max-width: 43rem;
      margin-left: 0;
      margin-right: 0;
    }
    /* 按钮+面板组 — 按钮为锚点，面板 absolute 向左下展开 */
    .panel-btn-group {
      position: relative;
      display: flex;
      justify-content: center;
    }
    /* 面板 — absolute 定位，距按钮左边缘 2px，从右滑入 */
    .panel-card {
      position: absolute;
      top: 0;
      right: calc(100% + 1rem);
      width: 14rem;
      overflow: visible;
      transition: opacity 0.28s ease 0.14s, transform 0.28s ease 0.14s;
    }
    .panel-card.closed {
      opacity: 0;
      pointer-events: none;
      transform: translateX(12px);
      transition: opacity 0.2s ease 0s, transform 0.2s ease 0s;
    }
    /* 面板内容 — 阴影随面板同步过渡 */
    .panel-content-body {
      background: var(--color-cream, #e4f3ed);
      border-radius: 0 0 12px 12px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.1);
      padding: clamp(0.75rem, 1.5vw, 1.25rem) 1rem;
      max-height: 60vh;
      overflow-y: scroll;
      transition: box-shadow 0.28s ease 0.14s;
    }
    .panel-card.closed .panel-content-body {
      box-shadow: 0 0 0 transparent;
      transition: box-shadow 0.2s ease 0s;
    }
    /* 面板头部 — 最小 40px，背景透明（由 ::before 统一提供） */
    .panel-header-bar {
      min-height: 40px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 0.75rem 0 1rem;
      background: transparent;
      position: relative;
      z-index: 1;
    }
    /* 胶囊 — fixed 定位，正文右侧 */
    #side-toolbar {
      position: fixed;
      z-index: 40;
      top: 12.5rem;
    }
    /* 统一背景条高度跟随头部 */
    .panel-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: -3.5rem;
      background: rgba(8, 145, 178, 0.1);
      border-radius: 12px 10px 10px 0;
      z-index: 0;
      pointer-events: none;
      height: 100%;
      max-height: 40px;
    }
    .dark .panel-card::before {
      background: rgba(34, 211, 238, 0.15);
    }
    .dark .panel-content-body {
      background: var(--color-night, #0a0f14);
      box-shadow: 0 4px 16px rgba(0,0,0,0.4);
    }
    /* 按钮激活 — 背景透明（由父容器 ::before 统一提供） */
    .panel-btn-group .toolbar-btn.active {
      border-radius: 0 10px 10px 0;
      border: none;
      background: transparent;
      position: relative;
      z-index: 1;
    }
    /* D-pad 按钮+菜单组 — 向下展开，统一背景 */
    .dpad-btn-group {
      position: relative;
    }
    /* D-pad 统一背景条 */
    .dpad-btn-group {
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
      border-radius: 10px;
      background: transparent;
      transition: background 0.2s ease;
    }
    .dpad-btn-group:has(.dpad-menu-body:not(.dpad-collapsed)) {
      background: rgba(8, 145, 178, 0.1);
      border-radius: 14px;
    }
    .dark .dpad-btn-group:has(.dpad-menu-body:not(.dpad-collapsed)) {
      background: rgba(34, 211, 238, 0.15);
    }
    .dpad-menu-body {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
      padding: 0 0.25rem;
      overflow: hidden;
      transition: max-height 0.25s ease, opacity 0.2s ease, padding 0.25s ease;
      max-height: 300px;
      opacity: 1;
      padding-top: 0.375rem;
      padding-bottom: 0.5rem;
    }
    .dpad-menu-body.dpad-collapsed {
      max-height: 0;
      opacity: 0;
      padding-top: 0;
      padding-bottom: 0;
    }
    /* 子按钮无边框无底色 */
    .dpad-btn-group .toolbar-btn,
    .dpad-menu-body .toolbar-btn,
    .dpad-menu-body .dpad-sub {
      position: relative;
      z-index: 1;
      background: transparent !important;
      border: none !important;
    }

    /* 2xl 宽屏：正文进一步放宽 */
    @media (min-width: 1536px) {
      #article-wrap {
        width: 72rem;
      }
      #article-content {
        width: 60rem;
        max-width: 60rem;
      }
      #article-content.narrowed {
        width: 51rem;
        max-width: 51rem;
      }
    }
  </style>

  <!-- 移动端遮罩层 -->
  <div
    id="mobile-overlay"
    class="fixed inset-0 bg-black/40 z-40 hidden"
    aria-hidden="true"
  ></div>

  <!-- ====== 整体 flex 布局：正文 + 面板 + 按钮列 ====== -->
  <div id="post-layout" class="hidden lg:flex items-start mx-auto">
    <!-- 文章固定宽容器 — 窄化时右侧留空给面板 -->
    <div id="article-wrap">
    <article id="article-content" class="min-w-0 pb-8" data-pagefind-body>
      <h1 class="text-3xl sm:text-4xl font-bold mb-4 text-ink dark:text-ghost">
        {entry.data.title}
      </h1>

      <div class="flex flex-wrap items-center gap-3 text-sm text-muted dark:text-muted-dark mb-6">
        <span>
          发布于 <time datetime={formatDate(entry.data.published)}>{formatDate(entry.data.published)}</time>
        </span>
        {
          entry.data.updated && entry.data.updated.getTime() !== entry.data.published.getTime() ? (
            <span>
              更新于 <time datetime={formatDate(entry.data.updated)}>{formatDate(entry.data.updated)}</time>
            </span>
          ) : null
        }
      </div>

      {
        entry.data.tags && entry.data.tags.length > 0 ? (
          <div class="flex flex-wrap gap-2 mb-8">
            {entry.data.tags.map((tag) => (
              <a
                href={`/tags/${encodeURIComponent(tag)}`}
                class="inline-block px-2.5 py-0.5 rounded-full text-xs font-medium border border-border-light dark:border-border-dark text-muted dark:text-muted-dark hover:border-accent hover:text-accent dark:hover:text-accent transition-colors no-underline"
              >
                {tag}
              </a>
            ))}
          </div>
        ) : null
      }

      <div class="prose mt-8">
        <Content />
      </div>

      <!-- 评论区置于文章容器内，随正文缩放，支持主题切换 -->
      <div id="giscus-desktop" class="mt-12">
        <GiscusComments />
      </div>
    </article>
    </div>{/* end article-wrap */}
  </div>{/* end #post-layout */}

  <!-- ====== 右侧悬浮按钮列（独立 fixed 定位） ====== -->
  <nav id="side-toolbar" class="hidden lg:flex flex-col">
      <div class="toolbar-capsule">
      <!-- 返回 -->
      <button id="btn-back" class="toolbar-btn" title="返回" onclick="history.back()">
        <svg class="w-5 h-5 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 10l-5 5 5 5"/>
	          <path d="M3 15h14a5 5 0 1 0 0-10h-3"/>
        </svg>
      </button>

      <!-- 目录 按钮+面板组 -->
      {
        tocHtml && (
          <div class="panel-btn-group">
            <button id="btn-toc" class="toolbar-btn" title="目录">
              <svg class="w-5 h-5 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="4" cy="6" r="1.5" fill="currentColor" stroke="none"/>
                <path d="M8 6h13"/>
                <circle cx="4" cy="12" r="1.5" fill="currentColor" stroke="none"/>
                <path d="M8 12h13"/>
                <circle cx="4" cy="18" r="1.5" fill="currentColor" stroke="none"/>
                <path d="M8 18h10"/>
              </svg>
            </button>
            <div id="panel-toc-wrap" class="panel-card closed" style="width:14rem">
                <div class="toc-panel-header panel-header-bar">
                  <h4 class="text-[clamp(0.9rem,1.1vw,1.1rem)] font-semibold uppercase tracking-wider text-ink dark:text-white">
                    目录
                  </h4>
                </div>
                <div id="toc-content" class="toc-panel-content panel-content-body relative" style="overflow-y:scroll">
                  <div id="toc-highlight-frame" class="absolute left-2 right-2 rounded-lg bg-gray-300/40 dark:bg-gray-600/30 pointer-events-none" style="top:0;height:0;transition:top 0.3s ease,height 0.3s ease"></div>
                  <nav id="toc-nav" class="toc-nav" set:html={tocHtml}></nav>
                </div>
            </div>
          </div>
        )
      }

      <!-- 合集 按钮+面板组 -->
      {
        currentSet && (
          <div class="panel-btn-group">
            <button id="btn-set" class="toolbar-btn" title="系列文章">
              <svg class="w-5 h-5 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="2" width="4.5" height="19" rx="0.5"/>
                <rect x="8" y="5" width="4.5" height="16" rx="0.5"/>
                <rect x="16" y="3" width="4.5" height="18" rx="0.5" transform="rotate(-10 18.25 21)"/>
              </svg>
            </button>
            <div id="panel-set-wrap" class="panel-card closed" style="width:14rem">
                <div class="panel-header-bar">
                  <h4 class="text-[clamp(0.8rem,1vw,1rem)] font-semibold text-ink dark:text-white">
                    {currentSet.name} — 第{currentSetIndex + 1}篇/共{setPosts.length}篇
                  </h4>
                </div>
                <div class="relative panel-content-body" style="max-height:50vh">
                  <nav class="flex flex-col" set:html={renderSetList()}></nav>
                </div>
            </div>
          </div>
        )
      }

      <!-- 标签 — 导航到首个标签页 -->
      {
        firstTag && (
          <a href={`/tags/${encodeURIComponent(firstTag)}`} id="btn-tag" class="toolbar-btn" title="标签">
            <svg class="w-5 h-5 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
              <circle cx="7" cy="7" r="2" fill="currentColor" stroke="none"/>
            </svg>
          </a>
        )
      }

      <!-- D-pad 按钮+菜单组 -->
      <div class="dpad-btn-group">
        <button id="btn-dpad" class="toolbar-btn" title="导航">
          <svg class="w-5 h-5 pointer-events-none" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round">
            <path d="M12 1l-3 5.5h6z"/>
            <path d="M12 23l3-5.5H9z"/>
            <path d="M23 12l-5.5-3v6z"/>
            <path d="M1 12l5.5-3v6z"/>
          </svg>
        </button>
        <!-- D-pad 子按钮胶囊 -->
        <div id="dpad-menu" class="dpad-collapsed dpad-menu-body">
          <button id="dpad-up" class="toolbar-btn dpad-sub" title="回到顶端">
            <svg class="w-4 h-4 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20V6m-5 5l5-5 5 5"/>
              <path d="M7 4h10"/>
            </svg>
          </button>
          <button id="dpad-down" class="toolbar-btn dpad-sub" title="跳到评论区">
            <svg class="w-4 h-4 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 4v14m5-5l-5 5-5-5"/>
              <path d="M7 20h10"/>
            </svg>
          </button>
          {
            prevPost && (
              <a href={`/posts/${prevPost.id}`} id="dpad-prev" class="toolbar-btn dpad-sub" title={prevPost.data.title}>
                <svg class="w-4 h-4 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 18l-6-6 6-6"/>
                  <path d="M18 18l-6-6 6-6"/>
                </svg>
              </a>
            )
          }
          {
            nextPost && (
              <a href={`/posts/${nextPost.id}`} id="dpad-next" class="toolbar-btn dpad-sub" title={nextPost.data.title}>
                <svg class="w-4 h-4 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 6l6 6-6 6"/>
                  <path d="M6 6l6 6-6 6"/>
                </svg>
              </a>
            )
          }
        </div>
      </div>
      </div>{/* end toolbar-capsule */}
    </nav>

  <!-- ====== 移动端：仅文章居中 ====== -->
  <article class="lg:hidden mx-auto max-w-3xl py-8" data-pagefind-body>
    <h1 class="text-3xl sm:text-4xl font-bold mb-4 text-ink dark:text-ghost">
      {entry.data.title}
    </h1>

    <div class="flex flex-wrap items-center gap-3 text-sm text-muted dark:text-muted-dark mb-6">
      <span>
        发布于 <time datetime={formatDate(entry.data.published)}>{formatDate(entry.data.published)}</time>
      </span>
      {
        entry.data.updated && entry.data.updated.getTime() !== entry.data.published.getTime() ? (
          <span>
            更新于 <time datetime={formatDate(entry.data.updated)}>{formatDate(entry.data.updated)}</time>
          </span>
        ) : null
      }
    </div>

    {
      entry.data.tags && entry.data.tags.length > 0 ? (
        <div class="flex flex-wrap gap-2 mb-8">
          {entry.data.tags.map((tag) => (
            <a
              href={`/tags/${encodeURIComponent(tag)}`}
              class="inline-block px-2.5 py-0.5 rounded-full text-xs font-medium border border-border-light dark:border-border-dark text-muted dark:text-muted-dark hover:border-accent hover:text-accent dark:hover:text-accent transition-colors no-underline"
            >
              {tag}
            </a>
          ))}
        </div>
      ) : null
    }

    <div class="prose mt-8">
      <Content />
    </div>

    <!-- 移动端评论区 -->
    <div class="mt-12">
      <GiscusComments />
    </div>
  </article>

  <!-- ====== 移动端工具栏（右下角） ====== -->
  <nav id="mobile-toolbar" class="lg:hidden fixed right-3 bottom-6 z-30 flex flex-col gap-2">
    <button id="mbtn-back" class="mobile-toolbar-btn" title="返回" onclick="history.back()">
      <svg class="w-4 h-4 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 10l-5 5 5 5"/>
	          <path d="M3 15h14a5 5 0 1 0 0-10h-3"/>
      </svg>
    </button>
    {
      tocHtml && (
        <button id="mbtn-toc" class="mobile-toolbar-btn" title="目录">
          <svg class="w-4 h-4 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="4" cy="6" r="1.5" fill="currentColor" stroke="none"/>
            <path d="M8 6h13"/>
            <circle cx="4" cy="12" r="1.5" fill="currentColor" stroke="none"/>
            <path d="M8 12h13"/>
            <circle cx="4" cy="18" r="1.5" fill="currentColor" stroke="none"/>
            <path d="M8 18h10"/>
          </svg>
        </button>
      )
    }
    {
      currentSet && (
        <button id="mbtn-set" class="mobile-toolbar-btn" title="合集">
          <svg class="w-4 h-4 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="2" width="5" height="19" rx="0.5"/>
            <rect x="9.5" y="5" width="5" height="16" rx="0.5"/>
            <rect x="18" y="3" width="5" height="18" rx="0.5" transform="rotate(-8 20.5 21)"/>
          </svg>
        </button>
      )
    }
    {
      firstTag && (
        <a href={`/tags/${encodeURIComponent(firstTag)}`} class="mobile-toolbar-btn" title="标签">
          <svg class="w-4 h-4 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
            <circle cx="7" cy="7" r="2" fill="currentColor" stroke="none"/>
          </svg>
        </a>
      )
    }
  </nav>

  <!-- ====== 移动端抽屉面板 ====== -->
  {
    tocHtml && (
      <aside
        id="toc-sidebar"
        class="toc-sidebar lg:hidden fixed top-0 right-0 z-50 h-full w-64 bg-cream dark:bg-night shadow-2xl px-5 py-6 overflow-y-auto translate-x-full transition-transform duration-300"
      >
        <button
          id="toc-sidebar-close"
          class="absolute top-4 right-4 w-8 h-8 rounded-full border border-border-light dark:border-border-dark flex items-center justify-center text-muted dark:text-muted-dark hover:text-accent transition-colors bg-transparent cursor-pointer"
          aria-label="关闭目录栏"
        >
          <svg class="w-4 h-4 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M18 6L6 18" /><path d="M6 6l12 12" />
          </svg>
        </button>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-muted dark:text-muted-dark mb-3">
          目录
        </h4>
        <nav class="toc-nav" set:html={tocHtml}></nav>
      </aside>
    )
  }
  {
    currentSet && (
      <aside
        id="set-sidebar"
        class="lg:hidden fixed top-0 right-0 z-50 h-full w-64 bg-cream dark:bg-night shadow-2xl px-5 py-6 overflow-y-auto translate-x-full transition-transform duration-300"
      >
        <button
          id="set-sidebar-close"
          class="absolute top-4 right-4 w-8 h-8 rounded-full border border-border-light dark:border-border-dark flex items-center justify-center text-muted dark:text-muted-dark hover:text-accent transition-colors bg-transparent cursor-pointer"
          aria-label="关闭合集栏"
        >
          <svg class="w-4 h-4 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M18 6L6 18" /><path d="M6 6l12 12" />
          </svg>
        </button>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-muted dark:text-muted-dark mb-3">
          {currentSet.name} — 第{currentSetIndex + 1}篇/共{setPosts.length}篇
        </h4>
        <nav class="flex flex-col" set:html={renderSetList()}></nav>
      </aside>
    )
  }
</BaseLayout>

<style>
  /* ---- 工具栏胶囊容器 ---- */
  .toolbar-capsule {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.375rem;
    background: #f4f4f5;
    border: none;
    border-radius: 20px;
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.07);
  }
  :global(.dark) .toolbar-capsule {
    background: #051f33;
    border: 0.5px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.5);
  }

  /* ---- 桌面工具栏按钮 ---- */
  .toolbar-btn {
    position: relative;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    border: none;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted, #6b7280);
    cursor: pointer;
    transition: color 0.2s, background-color 0.2s, transform 0.15s, border-color 0.2s;
    flex-shrink: 0;
    text-decoration: none;
  }
  .toolbar-btn:hover {
    color: var(--color-accent, #0891b2);
  }
  .toolbar-btn.active {
    color: var(--color-accent, #0891b2);
    background: rgba(8, 145, 178, 0.1);
    border-color: var(--color-accent, #0891b2);
  }
  .dark .toolbar-btn {
    color: var(--color-muted-dark, #9ca3af);
  }
  .dark .toolbar-btn:hover {
    color: var(--color-accent, #0891b2);
    border-color: var(--color-accent, #0891b2);
  }
  .dark .toolbar-btn.active {
    color: #22d3ee;
    background: rgba(34, 211, 238, 0.15);
    border-color: #22d3ee;
  }

  /* D-pad 胶囊 */
  #dpad-menu {
    max-height: 300px;
    opacity: 1;
  }
  #dpad-menu.dpad-collapsed {
    max-height: 0;
    opacity: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-width: 0;
    pointer-events: none;
  }
  .dpad-sub {
    width: 34px;
    height: 34px;
    border-radius: 14px;
  }

  .toc-panel-content {
    max-height: 60vh;
    overflow-y: scroll;
    opacity: 1;
  }

  /* ---- 移动端工具栏按钮 ---- */
  .mobile-toolbar-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--color-border-light, #cbd5e1);
    background: var(--color-cream, #e4f3ed);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted, #6b7280);
    cursor: pointer;
    transition: color 0.2s, background-color 0.2s, transform 0.15s;
    flex-shrink: 0;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }
  .dark .mobile-toolbar-btn {
    background: var(--color-night, #0a0f14);
    border-color: var(--color-border-dark, #2d3748);
    color: var(--color-muted-dark, #9ca3af);
  }
  .mobile-toolbar-btn:hover {
    color: var(--color-accent, #0891b2);
    transform: scale(1.08);
  }
  .dark .mobile-toolbar-btn:hover {
    color: #22d3ee;
  }

  /* TOC 链接通用 */
  .toc-nav a {
    position: relative;
    z-index: 1;
    line-height: clamp(1.1rem, 1.6vw, 1.45rem);
  }
  #toc-highlight-frame {
    transition: top 0.3s ease, height 0.3s ease, opacity 0.25s ease;
  }
</style>

<style is:global>
  main {
    max-width: 90rem;
  }

  /* 移动端侧边栏打开 */
  .toc-sidebar.open,
  #set-sidebar.open {
    transform: translateX(0) !important;
  }

  @media (max-width: 1023px) {
    .toc-sidebar,
