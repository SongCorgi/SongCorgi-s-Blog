  }
  :root.dark .toc-link-active {
    color: #22d3ee !important;
  }

  /* 进度条 */
  .toc-list {
    display: flex;
    flex-direction: column;
  }
  .toc-row {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    height: clamp(1.5rem, 2.0vw, 2.0rem);
  }
  .toc-progress {
    display: block;
    flex-shrink: 0;
    background: rgba(156, 163, 175, 0.6);
    height: 0.9rem;
  }
  .toc-progress-fill {
    display: block;
  }
  :root.dark .toc-progress {
    background: rgba(75, 85, 99, 0.5);
  }

  /* 合集链接hover */
  .set-link:hover {
    color: var(--color-accent) !important;
  }
</style>

<script data-astro-rerun>
  /* ======== 面板互斥切换 + D-pad + TOC 交互 ======== */

  /* ClientRouter 导航前清理上一页注册的 window 监听器 */
  const _tocWinListeners = [];
  function _tocAddWinListener(type, listener, options) {
    window.addEventListener(type, listener, options);
    _tocWinListeners.push([type, listener, options]);
  }
  function _tocCleanup() {
    for (const [type, listener, options] of _tocWinListeners) {
      window.removeEventListener(type, listener, options);
    }
    _tocWinListeners.length = 0;
  }
  document.addEventListener('astro:before-swap', _tocCleanup, { once: true });

  /* ---- DOM 引用 ---- */
  const isMobile = window.innerWidth < 1024;

  /* 桌面端 */
  const panelTocWrap = document.getElementById("panel-toc-wrap");
  const panelSetWrap = document.getElementById("panel-set-wrap");
  const btnToc = document.getElementById("btn-toc");
  const btnSet = document.getElementById("btn-set");
  const dpadBtn = document.getElementById("btn-dpad");
  const dpadMenu = document.getElementById("dpad-menu");

  /* 移动端 */
  const tocSidebar = document.getElementById("toc-sidebar");
  const setSidebar = document.getElementById("set-sidebar");
  const mobileOverlay = document.getElementById("mobile-overlay");
  const mbtnToc = document.getElementById("mbtn-toc");
  const mbtnSet = document.getElementById("mbtn-set");
  const tocSidebarClose = document.getElementById("toc-sidebar-close");
  const setSidebarClose = document.getElementById("set-sidebar-close");

  /* ---- 当前激活面板（先声明，positionToolbar 会用到）---- */
  let activePanel = null;

  /* ---- 胶囊独立定位：viewport 中心 + 正文半宽 + 间距 ---- */
  const postLayoutEl = document.getElementById("post-layout");
  const toolbarEl = document.getElementById("side-toolbar");
  function positionToolbar() {
    if (!postLayoutEl || !toolbarEl || isMobile) return;
    const wrap = document.getElementById("article-wrap");
    if (!wrap) return;
    const wrapRect = wrap.getBoundingClientRect();
    const remSize = parseFloat(getComputedStyle(document.documentElement).fontSize);
    toolbarEl.style.left = (wrapRect.right + 1 * remSize) + "px";
  }
  positionToolbar();
  window.addEventListener("resize", positionToolbar);
  /* scroll 时也更新，确保始终紧跟正文右边缘 */
  let _tbRaf = false;
  window.addEventListener("scroll", () => {
    if (_tbRaf) return;
    _tbRaf = true;
    requestAnimationFrame(() => { _tbRaf = false; positionToolbar(); });
  }, { passive: true });

  const articleContent = document.getElementById("article-content");

  function closeAllPanels() {
    if (panelTocWrap) panelTocWrap.classList.add("closed");
    if (panelSetWrap) panelSetWrap.classList.add("closed");
    if (btnToc) btnToc.classList.remove("active");
    if (btnSet) btnSet.classList.remove("active");
    if (articleContent) articleContent.classList.remove("narrowed");
    activePanel = null;
  }

  function openPanel(type) {
    if (activePanel === type) {
      closeAllPanels();
      return;
    }
    closeAllPanels();
    if (type === 'toc' && panelTocWrap) {
      panelTocWrap.classList.remove("closed");
      if (btnToc) btnToc.classList.add("active");
      if (articleContent) articleContent.classList.add("narrowed");
      activePanel = 'toc';
      requestAnimationFrame(() => updateSectionHighlights());
    } else if (type === 'set' && panelSetWrap) {
      panelSetWrap.classList.remove("closed");
      if (btnSet) btnSet.classList.add("active");
      if (articleContent) articleContent.classList.add("narrowed");
      activePanel = 'set';
      positionToolbar();
    }
  }

  if (btnToc) btnToc.addEventListener("click", () => openPanel('toc'));
  if (btnSet) btnSet.addEventListener("click", () => openPanel('set'));


  /* ---- D-pad 展开/折叠 ---- */
  if (dpadBtn && dpadMenu) {
    let dpadOpen = false;
    dpadBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      dpadOpen = !dpadOpen;
      if (dpadOpen) {
        dpadMenu.classList.remove("dpad-collapsed");
        dpadBtn.classList.add("active");
      } else {
        dpadMenu.classList.add("dpad-collapsed");
        dpadBtn.classList.remove("active");
      }
    });
    // 点击外部关闭 D-pad
    document.addEventListener("click", (e) => {
      if (dpadOpen && !dpadBtn.contains(e.target) && !dpadMenu.contains(e.target)) {
        dpadOpen = false;
        dpadMenu.classList.add("dpad-collapsed");
        dpadBtn.classList.remove("active");
      }
    });
  }

  /* ---- D-pad 方向按钮 ---- */
  document.getElementById("dpad-up")?.addEventListener("click", (e) => {
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: "smooth" });
  });
  document.getElementById("dpad-down")?.addEventListener("click", (e) => {
    e.preventDefault();
    const giscus = document.querySelector("#giscus-desktop giscus-widget, #giscus-desktop .giscus");
    if (giscus) {
      giscus.scrollIntoView({ behavior: "smooth", block: "start" });
    } else {
      // fallback: scroll near bottom but before very end
      const article = document.getElementById("article-content");
      if (article) {
        const articleBottom = article.getBoundingClientRect().bottom + window.scrollY - window.innerHeight * 0.15;
        window.scrollTo({ top: articleBottom, behavior: "smooth" });
      }
    }
  });

  /* ---- 移动端抽屉 ---- */
  function openMobileSidebar(type) {
    if (!mobileOverlay) return;
    mobileOverlay.classList.remove("hidden");
    if (type === 'toc' && tocSidebar) {
      tocSidebar.classList.add("open");
    }
    if (type === 'set' && setSidebar) {
      setSidebar.classList.add("open");
    }
  }

  function closeMobileSidebars() {
    if (tocSidebar) tocSidebar.classList.remove("open");
    if (setSidebar) setSidebar.classList.remove("open");
    if (mobileOverlay) mobileOverlay.classList.add("hidden");
  }

  if (mbtnToc) mbtnToc.addEventListener("click", () => openMobileSidebar('toc'));
  if (mbtnSet) mbtnSet.addEventListener("click", () => openMobileSidebar('set'));
  if (tocSidebarClose) tocSidebarClose.addEventListener("click", () => closeMobileSidebars());
  if (setSidebarClose) setSidebarClose.addEventListener("click", () => closeMobileSidebars());
  if (mobileOverlay) mobileOverlay.addEventListener("click", () => closeMobileSidebars());

  /* 移动端 TOC 链接点击后关闭抽屉 */
  if (tocSidebar) {
    tocSidebar.querySelectorAll("[data-toc-link]").forEach((link) => {
      link.addEventListener("click", () => closeMobileSidebars());
    });
  }

  /* ======== TOC 平滑滚动 ======== */
  document.querySelectorAll("[data-toc-link]").forEach((link) => {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      const id = e.target.getAttribute("data-toc-link");
      if (!id) return;
      const target = document.getElementById(id);
      if (target) {
        target.scrollIntoView({ behavior: "smooth" });
      }
      closeMobileSidebars();
    });
  });

  /* ======== 区段式滚动高亮 ======== */
  const visibleArticle = Array.from(document.querySelectorAll('[data-pagefind-body]')).find(
    (el) => el.checkVisibility(),
  );
  const headingEls = visibleArticle
    ? visibleArticle.querySelectorAll("h2[id], h3[id], h4[id], h5[id], h6[id]")
    : [];
  if (headingEls.length > 0) {
    const sections = [];
    for (let i = 0; i < headingEls.length; i++) {
      sections.push({
        id: headingEls[i].id,
        start: headingEls[i],
        end: headingEls[i + 1] ?? null,
      });
    }

    const tocContentEl = document.getElementById("toc-content");
    const highlightFrame = document.getElementById("toc-highlight-frame");

    function updateSectionHighlights() {
      const viewportBottom = window.innerHeight;
      const activeIds = new Set();
      const HANDOFF = Math.round(Math.min(Math.max(window.innerWidth * 0.04, 36), 64));

      for (const sec of sections) {
        const sectionTop = sec.start.getBoundingClientRect().top;
        const sectionBottom = sec.end
          ? sec.end.getBoundingClientRect().top - HANDOFF
          : (visibleArticle?.getBoundingClientRect().bottom ?? document.documentElement.scrollHeight - window.scrollY);
        if (sectionTop < viewportBottom && sectionBottom > 0) {
          activeIds.add(sec.id);
        }
      }

      document.querySelectorAll("[data-toc-link]").forEach((el) => {
        const link = el;
        const id = link.getAttribute("data-toc-link");
        if (id && activeIds.has(id)) {
          link.classList.add("toc-link-active");
        } else {
          link.classList.remove("toc-link-active");
        }
      });

      if (highlightFrame && tocContentEl) {
        const activeLinks = tocContentEl.querySelectorAll(".toc-link-active");
        if (activeLinks.length > 0) {
          const containerRect = tocContentEl.getBoundingClientRect();
          let minTop = Infinity;
          let maxBottom = -Infinity;
          for (const link of activeLinks) {
            const r = link.getBoundingClientRect();
            const top = r.top - containerRect.top + tocContentEl.scrollTop;
            const bottom = r.bottom - containerRect.top + tocContentEl.scrollTop;
            if (top < minTop) minTop = top;
            if (bottom > maxBottom) maxBottom = bottom;
          }
          highlightFrame.style.top = minTop + "px";
          highlightFrame.style.height = (maxBottom - minTop) + "px";
          highlightFrame.style.opacity = "1";

          const viewTop = tocContentEl.scrollTop;
          const viewBottom = viewTop + tocContentEl.clientHeight;
          const pad = 8;
          let targetTop = null;
          if (minTop < viewTop + pad) {
            targetTop = minTop - pad;
          } else if (maxBottom > viewBottom - pad) {
            targetTop = maxBottom - tocContentEl.clientHeight + pad;
          }
          if (targetTop !== null) {
            const start = tocContentEl.scrollTop;
            const distance = targetTop - start;
            const duration = 180;
            const startTime = performance.now();
            function easeOutCubic(t) { return 1 - Math.pow(1 - t, 3); }
            function animateScroll(now) {
              const elapsed = now - startTime;
              const t = Math.min(elapsed / duration, 1);
              tocContentEl.scrollTop = start + distance * easeOutCubic(t);
              if (t < 1) requestAnimationFrame(animateScroll);
            }
            requestAnimationFrame(animateScroll);
          }
        } else {
          highlightFrame.style.opacity = "0";
        }
      }

      /* 进度条 */
      let firstActiveIdx = -1;
      let lastActiveIdx = -1;
      for (let i = 0; i < sections.length; i++) {
        if (activeIds.has(sections[i].id)) {
          if (firstActiveIdx === -1) firstActiveIdx = i;
          lastActiveIdx = i;
        }
      }

      const progressBars = document.querySelectorAll(".toc-progress");
      for (const bar of progressBars) {
        const fill = bar.querySelector(".toc-progress-fill");
        if (!fill) continue;
        const slug = fill.getAttribute("data-progress-for");
        const secIdx = sections.findIndex((s) => s.id === slug);
        if (secIdx === -1) continue;
        const sec = sections[secIdx];
        const sectionTop = sec.start.getBoundingClientRect().top;
        const sectionEnd = sec.end
          ? sec.end.getBoundingClientRect().top + window.scrollY - HANDOFF
          : (visibleArticle?.getBoundingClientRect().bottom ?? 0) + window.scrollY;
        const sectionStart = sectionTop + window.scrollY;
        const sectionHeight = sectionEnd - sectionStart;

        if (firstActiveIdx === -1) {
          if (sectionTop >= window.innerHeight) {
            bar.style.visibility = "hidden";
          } else {
            bar.style.visibility = "visible";
            fill.style.height = "100%";
            fill.style.background = "var(--color-accent)";
          }
          continue;
        }

        if (secIdx > lastActiveIdx) {
          bar.style.visibility = "hidden";
          continue;
        }
        bar.style.visibility = "visible";

        if (secIdx < firstActiveIdx) {
          fill.style.height = "100%";
          fill.style.background = "var(--color-accent)";
        } else {
          const atBottom = (window.innerHeight + window.scrollY) >= (document.body.scrollHeight - 5);
          const progress = atBottom ? 1 : (sectionHeight > 0
            ? Math.max(0, Math.min(1, (window.scrollY - sectionStart) / sectionHeight))
            : 0);
          fill.style.height = (progress * 100) + "%";
          fill.style.background = "var(--color-accent)";
        }
      }
    }

    let sectionRaf = false;
    _tocAddWinListener("scroll", () => {
      if (sectionRaf) return;
      sectionRaf = true;
      requestAnimationFrame(() => {
        sectionRaf = false;
        updateSectionHighlights();
      });
    }, { passive: true });

    requestAnimationFrame(() => updateSectionHighlights());
    _tocAddWinListener("resize", () => updateSectionHighlights());
  }

  /* ======== Giscus 主题同步 ======== */
  function syncGiscusTheme() {
    const isDark = document.documentElement.classList.contains('dark');
    const theme = isDark ? 'dark' : 'light';
    // Update all giscus widgets on the page
    const giscusFrames = document.querySelectorAll('giscus-widget');
    giscusFrames.forEach((widget) => {
      // Giscus reacts to theme changes via the data-theme attribute
    });
    // Send message to giscus iframes
    document.querySelectorAll('iframe[src*="giscus"]').forEach((iframe) => {
      const src = iframe.getAttribute('src');
      if (src) {
        try {
          const url = new URL(src);
          url.searchParams.set('theme', theme);
          iframe.setAttribute('src', url.toString());
        } catch(e) {}
      }
    });
  }

  function restoreGiscusTheme() {
    const saved = localStorage.getItem('theme');
    const isDark = saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches);
    const theme = isDark ? 'dark' : 'light';
    document.querySelectorAll('iframe[src*="giscus"]').forEach((iframe) => {
      const src = iframe.getAttribute('src');
      if (src) {
        try {
          const url = new URL(src);
          url.searchParams.set('theme', theme);
          iframe.setAttribute('src', url.toString());
        } catch(e) {}
      }
    });
  }

  restoreGiscusTheme();
  document.addEventListener('astro:after-swap', restoreGiscusTheme);

  /* Giscus 主题跟随手动切换（监听 Header 中的主题切换） */
  const themeToggle = document.getElementById('theme-toggle');
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      setTimeout(syncGiscusTheme, 100);
    });
  }
</script>
