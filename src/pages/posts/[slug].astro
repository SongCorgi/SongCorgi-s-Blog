---
/* [slug].astro — 文章阅读页，渲染完整 markdown 内容 */

import { getCollection, getEntry, render } from "astro:content";
import { formatDate } from "../../utils/post";
import BaseLayout from "../../layouts/BaseLayout.astro";

/* getStaticPaths：为每篇文章生成静态页面 */
export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((p) => ({ params: { slug: p.id } }));
}

/* 当前路由参数 */
const { slug } = Astro.params;

/* 通过 slug 获取单篇文章 entry */
const entry = await getEntry("posts", slug!);

/* 文章不存在时重定向到 404（此处简化处理，显示提示） */
if (!entry) {
  return new Response("文章未找到", { status: 404 });
}

/* 渲染 markdown 为 Astro 组件 */
const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.coverImage ?? "/favicon.svg"}
>
  <article class="py-8">
    <!-- 返回链接 -->
    <a
      href="/tags"
      class="inline-block text-sm text-muted dark:text-muted-dark hover:text-accent dark:hover:text-accent transition-colors no-underline mb-6"
    >
      &larr; 返回标签列表
    </a>

    <!-- 文章标题 -->
    <h1 class="text-3xl sm:text-4xl font-bold mb-4 text-ink dark:text-ghost">
      {entry.data.title}
    </h1>

    <!-- Meta 信息行：日期 + 标签 -->
    <div
      class="flex flex-wrap items-center gap-3 text-sm text-muted dark:text-muted-dark mb-6"
    >
      <span>
        发布于 <time datetime={formatDate(entry.data.published)}>{formatDate(entry.data.published)}</time>
      </span>

      {
        entry.data.updated && entry.data.updated.getTime() !== entry.data.published.getTime() ? (
          <span>
            更新于 <time datetime={formatDate(entry.data.updated)}>{formatDate(entry.data.updated)}</time>
          </span>
        ) : null
      }
    </div>

    <!-- 封面图片（可选） -->
    {
      entry.data.coverImage ? (
        <img
          src={entry.data.coverImage}
          alt={entry.data.title}
          class="w-full rounded-lg mb-8"
        />
      ) : null
    }

    <!-- 标签药丸 -->
    {
      entry.data.tags && entry.data.tags.length > 0 ? (
        <div class="flex flex-wrap gap-2 mb-8">
          {entry.data.tags.map((tag) => (
            <a
              href={`/tags/${encodeURIComponent(tag)}`}
              class="inline-block px-2.5 py-0.5 rounded-full text-xs font-medium border border-border-light dark:border-border-dark text-muted dark:text-muted-dark hover:border-accent hover:text-accent dark:hover:text-accent transition-colors no-underline"
            >
              {tag}
            </a>
          ))}
        </div>
      ) : null
    }

    <!-- 文章正文 -->
    <div class="prose mt-8">
      <Content />
    </div>

    <!-- 底部导航 -->
    <nav
      class="mt-12 pt-6 border-t border-border-light dark:border-border-dark"
    >
      <a
        href="/tags"
        class="text-sm text-muted dark:text-muted-dark hover:text-accent dark:hover:text-accent transition-colors no-underline"
      >
        &larr; 返回标签列表
      </a>
    </nav>
  </article>
</BaseLayout>
