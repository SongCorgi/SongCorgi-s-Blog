---
/* [slug].astro — 文章阅读页，渲染完整 markdown 内容 + 左侧大纲栏 */

import { getCollection, getEntry, render } from "astro:content";
import { formatDate } from "../../utils/post";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((p) => ({ params: { slug: p.id } }));
}

const { slug } = Astro.params;
const entry = await getEntry("posts", slug!);

if (!entry) {
  return new Response("文章未找到", { status: 404 });
}

const { Content, headings } = await render(entry);

/* ---- 构建大纲树形结构 ---- */
interface TocNode {
  depth: number;
  slug: string;
  text: string;
  children: TocNode[];
}

function buildTocTree(items: typeof headings): TocNode[] {
  const root: TocNode[] = [];
  const stack: TocNode[] = [];
  for (const h of items) {
    const node: TocNode = { depth: h.depth, slug: h.slug, text: h.text, children: [] };
    while (stack.length > 0 && stack[stack.length - 1].depth >= h.depth) {
      stack.pop();
    }
    if (stack.length === 0) {
      root.push(node);
    } else {
      stack[stack.length - 1].children.push(node);
    }
    stack.push(node);
  }
  return root;
}

const tocTree = buildTocTree(headings);

/* ---- 递归渲染大纲 HTML ---- */
function getIndentStyle(depth: number): string {
  const base = 12;
  const extra = (depth - 2) * 16;
  return `padding-left: ${base + extra}px`;
}

function getSizeClass(depth: number): string {
  if (depth <= 2) return "text-sm";
  if (depth <= 4) return "text-xs";
  return "text-[0.65rem]";
}

function renderToc(nodes: TocNode[]): string {
  if (!nodes.length) return "";

  // 扁平化：将树形结构展开为深度标注的平列表
  function flatten(list: TocNode[], result: TocNode[] = []): TocNode[] {
    for (const n of list) {
      result.push(n);
      if (n.children.length > 0) flatten(n.children, result);
    }
    return result;
  }
  const flat = flatten(nodes);

  // 所有行放在同一 flex column 容器，gap 精确统一
  let h = '<div class="toc-list">';
  for (const node of flat) {
    h += '<div class="toc-row">';
    h += `<span class="toc-progress" style="display:block;width:2px;border-radius:9999px;height:clamp(1.05rem,1.6vw,1.6rem)">`;
    h += `<span class="toc-progress-fill" data-progress-for="${node.slug}" style="display:block;height:0%;border-radius:9999px;background:var(--color-accent)"></span>`;
    h += `</span>`;
    h +=
      `<a href="#${node.slug}" data-toc-link="${node.slug}" style="${getIndentStyle(node.depth)}" class="${getSizeClass(node.depth)} block truncate transition-colors no-underline hover:text-accent text-black dark:text-ghost">${node.text}</a>`;
    h += "</div>";
  }
  h += "</div>";
  return h;
}

const tocHtml = headings.length > 0 ? renderToc(tocTree) : "";
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.coverImage ?? "/favicon.svg"}
>
  <!-- 大纲侧边栏的移动端遮罩层 -->
  <div
    id="toc-overlay"
    class="toc-overlay fixed inset-0 bg-black/40 z-40 hidden"
    aria-hidden="true"
  ></div>

  <!-- 移动端浮动按钮：打开大纲栏 -->
  <button
    id="toc-mobile-open"
    class="lg:hidden fixed left-3 bottom-6 z-30 w-10 h-10 rounded-full border border-border-light dark:border-border-dark bg-cream dark:bg-night shadow-lg flex items-center justify-center text-muted dark:text-muted-dark hover:text-accent transition-colors cursor-pointer"
    aria-label="打开大纲栏"
  >
    <svg
      class="w-5 h-5 pointer-events-none"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    >
      <path d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </button>

  <!-- ====== 桌面端：面板 + 正文 flex 布局，整体居中 ====== -->
  <div id="toc-group" class="toc-group hidden lg:block mx-auto">
    <div id="toc-flex-row" class="flex items-start">
    <!-- 大纲面板：sticky 悬浮，始终可见 -->
    {
      tocHtml && (
        <div id="toc-sticky-wrap" class="shrink-0 sticky">
          <!-- 返回按钮：与目录栏绑定悬浮，绝对定位在面板上方 -->
          <button
            onclick="history.back()"
            class="inline-flex items-center px-4 py-1.5 rounded-full text-[clamp(0.75rem,1vw,0.9rem)] border border-border-light dark:border-border-dark text-muted dark:text-muted-dark hover:border-accent hover:text-accent dark:hover:text-accent transition-colors bg-transparent cursor-pointer absolute -top-9 left-0"
          >
            &larr; 返回
          </button>
          <aside
            id="toc-panel"
            class="
              toc-panel
              rounded-xl
              border border-border-light dark:border-border-dark
              shadow-lg
              overflow-hidden
            "
          >
          <div class="toc-panel-header flex items-center justify-between px-4 pt-2 pb-2.5 bg-[#b2f0e3]/40 dark:bg-[#0f766e]/40">
            <h4 class="text-[clamp(0.9rem,1.1vw,1.1rem)] font-semibold uppercase tracking-wider text-ink dark:text-white">
              目录
            </h4>
            <button
              id="toc-toggle-btn"
              class="
                toc-toggle-btn
                w-7 h-7
                rounded-full
                border border-ink/30 dark:border-white/30
                bg-transparent
                flex items-center justify-center
                text-ink dark:text-white
                hover:border-ink/60 dark:hover:border-white/60
                cursor-pointer
                shrink-0
              "
              aria-label="切换大纲栏"
            >
              <svg
                class="w-3.5 h-3.5 pointer-events-none"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M6 6l6 6 6-6M6 12l6 6 6-6" />
              </svg>
            </button>
          </div>

          <div id="toc-content" class="toc-panel-content relative px-4 py-[clamp(0.75rem,1.5vw,1.25rem)] max-h-[60vh] overflow-y-auto bg-white/30 dark:bg-black/30">
            <div id="toc-highlight-frame" class="absolute left-2 right-2 rounded-lg bg-gray-300/40 dark:bg-gray-600/30 pointer-events-none" style="top:0;height:0;transition:top 0.3s ease,height 0.3s ease"></div>
            <nav id="toc-nav" class="toc-nav" set:html={tocHtml}></nav>
          </div>
        </aside>
        </div>
      )
    }

    <!-- 文章内容 -->
    <article id="article-content" class="flex-1 min-w-0 pb-8" data-pagefind-body>
      <h1 class="text-3xl sm:text-4xl font-bold mb-4 text-ink dark:text-ghost">
        {entry.data.title}
      </h1>

      <div class="flex flex-wrap items-center gap-3 text-sm text-muted dark:text-muted-dark mb-6">
        <span>
          发布于 <time datetime={formatDate(entry.data.published)}>{formatDate(entry.data.published)}</time>
        </span>
        {
          entry.data.updated && entry.data.updated.getTime() !== entry.data.published.getTime() ? (
            <span>
              更新于 <time datetime={formatDate(entry.data.updated)}>{formatDate(entry.data.updated)}</time>
            </span>
          ) : null
        }
      </div>

      {entry.data.coverImage ? (
        <img src={entry.data.coverImage} alt={entry.data.title} class="w-full rounded-lg mb-8" />
      ) : null}

      {
        entry.data.tags && entry.data.tags.length > 0 ? (
          <div class="flex flex-wrap gap-2 mb-8">
            {entry.data.tags.map((tag) => (
              <a
                href={`/tags/${encodeURIComponent(tag)}`}
                class="inline-block px-2.5 py-0.5 rounded-full text-xs font-medium border border-border-light dark:border-border-dark text-muted dark:text-muted-dark hover:border-accent hover:text-accent dark:hover:text-accent transition-colors no-underline"
              >
                {tag}
              </a>
            ))}
          </div>
        ) : null
      }

      <div class="prose mt-8">
        <Content />
      </div>
    </article>
    </div>
  </div>

  <!-- ====== 移动端：仅文章居中 ====== -->
  <article class="lg:hidden mx-auto max-w-3xl py-8" data-pagefind-body>
    <h1 class="text-3xl sm:text-4xl font-bold mb-4 text-ink dark:text-ghost">
      {entry.data.title}
    </h1>

    <div class="flex flex-wrap items-center gap-3 text-sm text-muted dark:text-muted-dark mb-6">
      <span>
        发布于 <time datetime={formatDate(entry.data.published)}>{formatDate(entry.data.published)}</time>
      </span>
      {
        entry.data.updated && entry.data.updated.getTime() !== entry.data.published.getTime() ? (
          <span>
            更新于 <time datetime={formatDate(entry.data.updated)}>{formatDate(entry.data.updated)}</time>
          </span>
        ) : null
      }
    </div>

    {entry.data.coverImage ? (
      <img src={entry.data.coverImage} alt={entry.data.title} class="w-full rounded-lg mb-8" />
    ) : null}

    {
      entry.data.tags && entry.data.tags.length > 0 ? (
        <div class="flex flex-wrap gap-2 mb-8">
          {entry.data.tags.map((tag) => (
            <a
              href={`/tags/${encodeURIComponent(tag)}`}
              class="inline-block px-2.5 py-0.5 rounded-full text-xs font-medium border border-border-light dark:border-border-dark text-muted dark:text-muted-dark hover:border-accent hover:text-accent dark:hover:text-accent transition-colors no-underline"
            >
              {tag}
            </a>
          ))}
        </div>
      ) : null
    }

    <div class="prose mt-8">
      <Content />
    </div>
  </article>

  <!-- 移动端大纲抽屉 -->
  {
    tocHtml && (
      <aside
        id="toc-sidebar"
        class="
          toc-sidebar
          lg:hidden fixed
          top-0 left-0
          z-50
          h-full w-64
          bg-cream dark:bg-night
          shadow-2xl
          px-5 py-6
          overflow-y-auto
          -translate-x-full
          transition-transform duration-300
        "
      >
        <button
          id="toc-close-btn"
          class="absolute top-4 right-4 w-8 h-8 rounded-full border border-border-light dark:border-border-dark flex items-center justify-center text-muted dark:text-muted-dark hover:text-accent transition-colors bg-transparent cursor-pointer"
          aria-label="关闭大纲栏"
        >
          <svg
            class="w-4 h-4 pointer-events-none"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <path d="M18 6L6 18" /><path d="M6 6l12 12" />
          </svg>
        </button>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-muted dark:text-muted-dark mb-3">
          目录
        </h4>
        <nav class="toc-nav" set:html={tocHtml}></nav>
      </aside>
    )
  }
</BaseLayout>

<script>
  /* ======== 大纲栏交互脚本 ======== */
  const panel = document.getElementById("toc-panel");
  const sidebar = document.getElementById("toc-sidebar");
  const overlay = document.getElementById("toc-overlay");
  const toggleBtn = document.getElementById("toc-toggle-btn");
  const closeBtn = document.getElementById("toc-close-btn");
  const mobileOpenBtn = document.getElementById("toc-mobile-open");
  const article = document.getElementById("article-content");

  /* ---- 桌面端：面板折叠/展开 + 宽度适配 ---- */
  if (panel && toggleBtn) {
    let tocExpanded = true;
    const tocGroup = document.getElementById("toc-group");

    // 面板垂直居中 + 文章标题对齐
    function syncStickyTop() {
      if (!panel || !tocGroup) return;
      const vh = window.innerHeight;
      const panelH = panel.offsetHeight;
      const centeredTop = Math.max(0, (vh - panelH) / 2);

      // 重置 padding 读取 flex row 的自然位置
      tocGroup.style.paddingTop = "";
      const flexRow = document.getElementById("toc-flex-row");
      const naturalTop = flexRow ? flexRow.getBoundingClientRect().top : 0;

      // 补上顶部间距，使面板上沿与文章标题上沿（flex line）都到达 centeredTop
      const extraPad = centeredTop - naturalTop;
      tocGroup.style.paddingTop = Math.max(0, extraPad) + "px";

      const stickyWrap = document.getElementById("toc-sticky-wrap");
      if (stickyWrap) stickyWrap.style.top = centeredTop + "px";
    }
    syncStickyTop();
    window.addEventListener("resize", () => {
      updateLayoutWidths();
      if (tocExpanded) syncStickyTop();
    });

    // 面板目标宽度（px），用于避免在 CSS 过渡期间读取中间态的 offsetWidth
    const remSize = parseFloat(getComputedStyle(document.documentElement).fontSize);
    const PANEL_WIDE = 14 * remSize;
    const PANEL_NARROW = 6 * remSize;

    function clampValue(vw: number, minVw: number, maxVw: number, minVal: number, maxVal: number): number {
      const t = Math.max(0, Math.min(1, (vw - minVw) / (maxVw - minVw)));
      return minVal + t * (maxVal - minVal);
    }

    function collapsePanel() {
      tocExpanded = false;
      panel!.classList.add("collapsed");
      toggleBtn!.classList.add("rotated");
      updateLayoutWidths();
    }

    function expandPanel() {
      tocExpanded = true;
      panel!.classList.remove("collapsed");
      toggleBtn!.classList.remove("rotated");
      updateLayoutWidths();
    }

    toggleBtn.addEventListener("click", () => {
      if (tocExpanded) collapsePanel();
      else expandPanel();
    });

    /* 动态调整：响应式边距 + 面板/正文宽度，整体居中，至少占 70vw */
    function updateLayoutWidths() {
      if (!article || !tocGroup || window.innerWidth < 1024) return;
      const vw = window.innerWidth;
      const pw = tocExpanded ? PANEL_WIDE : PANEL_NARROW;

      // 间距：48px（1024px 屏）→ 64px（1600px+ 屏）
      const gap = clampValue(vw, 1024, 1600, 48, 64);

      // 目标侧边距：16px（窄屏）→ 96px（宽屏），保证 group ≥ 70vw
      const sideMargin = clampValue(vw, 1024, 1600, 16, 96);
      const available = vw - 2 * sideMargin;

      // 文章自然宽度上限：640px → 800px
      const articleCap = clampValue(vw, 1024, 1600, 640, 800);

      // group 最大宽度：≥ 70vw，≤ 可用宽，≤ 面板+间距+文章上限
      const naturalWidth = pw + gap + articleCap;
      const groupMax = Math.max(vw * 0.7, Math.min(available, naturalWidth));

      tocGroup.style.maxWidth = groupMax + "px";
      const flexRow = document.getElementById("toc-flex-row");
      if (flexRow) flexRow.style.gap = gap + "px";

      const articleMax = groupMax - pw - gap;
      article.style.maxWidth = articleMax + "px";
    }

    window.addEventListener("resize", updateLayoutWidths);
    updateLayoutWidths();
  }

  /* ---- 移动端：抽屉式大纲栏 ---- */
  if (sidebar) {
    function openSidebar() {
      sidebar!.classList.add("toc-open");
      sidebar!.classList.remove("-translate-x-full");
      overlay?.classList.remove("hidden");
      if (mobileOpenBtn) mobileOpenBtn.style.display = "none";
    }

    function closeSidebar() {
      sidebar!.classList.remove("toc-open");
      sidebar!.classList.add("-translate-x-full");
      overlay?.classList.add("hidden");
      if (mobileOpenBtn) mobileOpenBtn.style.display = "";
    }

    mobileOpenBtn?.addEventListener("click", () => openSidebar());
    closeBtn?.addEventListener("click", () => closeSidebar());
    overlay?.addEventListener("click", () => closeSidebar());

    /* 移动端 TOC 链接点击后关闭抽屉 */
    sidebar.querySelectorAll("[data-toc-link]").forEach((link) => {
      link.addEventListener("click", () => closeSidebar());
    });
  }

  /* ======== 平滑滚动 + 移动端关闭侧边栏 ======== */
  document.querySelectorAll("[data-toc-link]").forEach((link) => {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      const id = (e.target as HTMLElement).getAttribute("data-toc-link");
      if (!id) return;
      const target = document.getElementById(id);
      if (target) {
        target.scrollIntoView({ behavior: "smooth" });
      }
      if (window.innerWidth < 1024) {
        sidebar?.classList.add("-translate-x-full");
        sidebar?.classList.remove("toc-open");
        overlay?.classList.add("hidden");
      }
    });
  });

  /* ======== 区段式滚动高亮：标题所属内容在视口内即高亮，可同时高亮多个 ======== */
  /* 仅选取可见的 article（桌面/移动端各有一个，display:none 的不计） */
  const visibleArticle = Array.from(document.querySelectorAll('[data-pagefind-body]')).find(
    (el) => getComputedStyle(el).display !== 'none',
  );
  const headingEls = visibleArticle
    ? visibleArticle.querySelectorAll("h2[id], h3[id], h4[id], h5[id], h6[id]")
    : ([] as any);
  if (headingEls.length > 0) {
    /* 构建区段：每个标题的区间 = [该标题, 下一个任意级别标题)，无父子联动 */
    interface Section {
      id: string;
      start: Element;
      end: Element | null; // null = 文章内容区底部
    }
    const sections: Section[] = [];
    for (let i = 0; i < headingEls.length; i++) {
      sections.push({
        id: headingEls[i].id,
        start: headingEls[i],
        end: headingEls[i + 1] ?? null,
      });
    }

    const tocContent = document.getElementById("toc-content");
    const highlightFrame = document.getElementById("toc-highlight-frame");

    function updateSectionHighlights() {
      const viewportBottom = window.innerHeight;
      const activeIds = new Set<string>();
      const HANDOFF = Math.round(Math.min(Math.max(window.innerWidth * 0.04, 36), 64));

      for (const sec of sections) {
        const sectionTop = sec.start.getBoundingClientRect().top;
        const sectionBottom = sec.end
          ? sec.end.getBoundingClientRect().top - HANDOFF
          : (visibleArticle?.getBoundingClientRect().bottom ?? document.documentElement.scrollHeight - window.scrollY);

        // 区段与视口有交集即高亮
        if (sectionTop < viewportBottom && sectionBottom > 0) {
          activeIds.add(sec.id);
        }
      }

      document.querySelectorAll("[data-toc-link]").forEach((el) => {
        const link = el as HTMLElement;
        const id = link.getAttribute("data-toc-link");
        if (id && activeIds.has(id)) {
          link.classList.add("toc-link-active");
        } else {
          link.classList.remove("toc-link-active");
        }
      });

      // 定位高亮框：覆盖所有激活的 TOC 链接
      if (highlightFrame && tocContent) {
        const activeLinks = tocContent.querySelectorAll(".toc-link-active");
        if (activeLinks.length > 0) {
          const containerRect = tocContent.getBoundingClientRect();
          let minTop = Infinity;
          let maxBottom = -Infinity;
          for (const link of activeLinks) {
            const r = link.getBoundingClientRect();
            const top = r.top - containerRect.top + tocContent.scrollTop;
            const bottom = r.bottom - containerRect.top + tocContent.scrollTop;
            if (top < minTop) minTop = top;
            if (bottom > maxBottom) maxBottom = bottom;
          }
          highlightFrame.style.top = minTop + "px";
          highlightFrame.style.height = (maxBottom - minTop) + "px";
          highlightFrame.style.opacity = "1";

          // 自动滚动目录内容区，使高亮框保持可见（自定义缓动动画）
          const viewTop = tocContent.scrollTop;
          const viewBottom = viewTop + tocContent.clientHeight;
          const pad = 8;
          let targetTop: number | null = null;
          if (minTop < viewTop) {
            targetTop = minTop - pad;
          } else if (maxBottom > viewBottom) {
            targetTop = maxBottom - tocContent.clientHeight + pad;
          }
          if (targetTop !== null) {
            const start = tocContent.scrollTop;
            const distance = targetTop - start;
            const duration = 180; // ms
            const startTime = performance.now();
            function easeOutCubic(t: number): number { return 1 - Math.pow(1 - t, 3); }
            function animateScroll(now: number) {
              const elapsed = now - startTime;
              const t = Math.min(elapsed / duration, 1);
              tocContent!.scrollTop = start + distance * easeOutCubic(t);
              if (t < 1) requestAnimationFrame(animateScroll);
            }
            requestAnimationFrame(animateScroll);
          }
        } else {
          highlightFrame.style.opacity = "0";
        }
      }

      // 更新每个标题的阅读进度条
      // 找到活跃区段在 sections 数组中的索引范围（所有 bar 共用，只算一次）
      let firstActiveIdx = -1;
      let lastActiveIdx = -1;
      for (let i = 0; i < sections.length; i++) {
        if (activeIds.has(sections[i].id)) {
          if (firstActiveIdx === -1) firstActiveIdx = i;
          lastActiveIdx = i;
        }
      }

      const progressBars = document.querySelectorAll(".toc-progress");
      for (const bar of progressBars) {
        const fill = bar.querySelector(".toc-progress-fill") as HTMLElement | null;
        if (!fill) continue;
        const slug = fill.getAttribute("data-progress-for");
        const secIdx = sections.findIndex((s) => s.id === slug);
        if (secIdx === -1) continue;
        const sec = sections[secIdx];
        const sectionTop = sec.start.getBoundingClientRect().top;
        const sectionEnd = sec.end
          ? sec.end.getBoundingClientRect().top + window.scrollY - HANDOFF
          : (visibleArticle?.getBoundingClientRect().bottom ?? 0) + window.scrollY;
        const sectionStart = sectionTop + window.scrollY;
        const sectionHeight = sectionEnd - sectionStart;

        // 无活跃区段 → 回退到视口逻辑
        if (firstActiveIdx === -1) {
          if (sectionTop >= window.innerHeight) {
            (bar as HTMLElement).style.visibility = "hidden";
          } else {
            (bar as HTMLElement).style.visibility = "visible";
            fill.style.height = "100%";
            fill.style.background = "var(--color-accent)";
          }
          continue;
        }

        // 圆角框下方 → 完全隐藏
        if (secIdx > lastActiveIdx) {
          (bar as HTMLElement).style.visibility = "hidden";
          continue;
        }
        (bar as HTMLElement).style.visibility = "visible";

        if (secIdx < firstActiveIdx) {
          // 圆角框上方 → 满格青色（已读完）
          fill.style.height = "100%";
          fill.style.background = "var(--color-accent)";
        } else {
          // 圆角框内 → 按阅读进度显示青色，页底兜底走满
          const atBottom = (window.innerHeight + window.scrollY) >= (document.body.scrollHeight - 5);
          const progress = atBottom ? 1 : (sectionHeight > 0
            ? Math.max(0, Math.min(1, (window.scrollY - sectionStart) / sectionHeight))
            : 0);
          fill.style.height = (progress * 100) + "%";
          fill.style.background = "var(--color-accent)";
        }
      }
    }

    let sectionRaf = false;
    window.addEventListener("scroll", () => {
      if (sectionRaf) return;
      sectionRaf = true;
      requestAnimationFrame(() => {
        sectionRaf = false;
        updateSectionHighlights();
      });
    }, { passive: true });

    // 初始调用 + resize 时重算
    updateSectionHighlights();
    window.addEventListener("resize", updateSectionHighlights);
  }
</script>

