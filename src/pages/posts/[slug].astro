---
/* [slug].astro — 文章阅读页 */

import { getCollection, getEntry, render } from "astro:content";
import { formatDate, getSets } from "../../utils/post";
import { buildTocTree, renderToc } from "../../utils/toc";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GiscusComments from "../../components/GiscusComments.astro";
import PostMeta from "../../components/PostMeta.astro";
import PostToolbar from "../../components/PostToolbar.astro";
import "katex/dist/katex.min.css";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((p) => ({ params: { slug: p.id } }));
}

const { slug } = Astro.params;
const entry = await getEntry("posts", slug!);

if (!entry) {
  return new Response("文章未找到", { status: 404 });
}

const { Content, headings } = await render(entry);

/* ---- 合集数据 ---- */
const allPosts = await getCollection("posts");
const sets = getSets(allPosts);
const currentSet = sets.find(s => s.name === entry.data.belongToSet);
const setPosts = currentSet?.posts.sort((a, b) =>
  a.published.getTime() - b.published.getTime()
) ?? [];
const currentSetIndex = setPosts.findIndex(p => p.slug === slug);

/* ---- 上下篇（按发表时间升序，取邻篇） ---- */
const allPostsSorted = allPosts.sort((a, b) =>
  a.data.published.getTime() - b.data.published.getTime()
);
const allIdx = allPostsSorted.findIndex(p => p.id === slug);
const prevPost = allIdx > 0 ? allPostsSorted[allIdx - 1] : null;
const nextPost = allIdx < allPostsSorted.length - 1 ? allPostsSorted[allIdx + 1] : null;

/* ---- 首个标签 ---- */
const firstTag = entry.data.tags?.[0] ?? null;

const tocHtml = headings.length > 0 ? renderToc(buildTocTree(headings)) : "";
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage="/favicon.svg"
>
  <!-- 关键 CSS：保证 ClientRouter 导航时布局正确 -->
  <style is:inline>
    main { max-width: 90rem }
    #post-layout { width: fit-content; max-width: 100%; margin-left: auto; margin-right: auto; padding-top: 4.5rem }
    #article-wrap { width: 66rem; flex-shrink: 0 }
    #article-content { width: 52rem; max-width: 52rem; min-width: 0; margin-left: 7rem; margin-right: 7rem; transition: width 0.28s ease, max-width 0.28s ease, margin-left 0.28s ease, margin-right 0.28s ease }
    #article-content.narrowed { width: 44rem; max-width: 44rem; margin-left: 0; margin-right: 0 }
    @media (min-width: 1536px) {
      #article-wrap { width: 74rem }
      #article-content { width: 60rem; max-width: 60rem }
      #article-content.narrowed { width: 52rem; max-width: 52rem }
    }

    /* 移动端最小高度：确保装得下 header + 汉堡 + 胶囊 */
    @media (max-width: 1279px) {
      html, body { min-height: 480px }
    }
  </style>

  <!-- ====== 工具栏（桌面 + 移动端 + 抽屉面板） ====== -->
  <PostToolbar
    tocHtml={tocHtml}
    currentSet={currentSet}
    currentSetIndex={currentSetIndex}
    setPosts={setPosts}
    slug={slug || ""}
    firstTag={firstTag}
    prevPost={prevPost}
    nextPost={nextPost}
  />

  <!-- ====== 桌面端：flex 布局 ====== -->
  <div id="post-layout" class="hidden xl:flex items-start mx-auto">
    <div id="article-wrap">
    <article id="article-content" class="min-w-0 pb-8" data-pagefind-body>
      <PostMeta
        title={entry.data.title}
        published={entry.data.published}
        updated={entry.data.updated}
        tags={entry.data.tags}
      />
      <div class="prose mt-8">
        <Content />
      </div>
      <GiscusComments />
    </article>
    </div>
  </div>

  <!-- ====== 移动端文章 ====== -->
  <article class="xl:hidden mx-auto max-w-3xl py-8" data-pagefind-body>
    <PostMeta
      title={entry.data.title}
      published={entry.data.published}
      updated={entry.data.updated}
      tags={entry.data.tags}
    />
    <div class="prose mt-8">
      <Content />
    </div>
    <GiscusComments />
  </article>
</BaseLayout>
