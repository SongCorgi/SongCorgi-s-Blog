---
/* [slug].astro — 文章阅读页，渲染完整 markdown 内容 + 左侧大纲栏 */

import { getCollection, getEntry, render } from "astro:content";
import { formatDate } from "../../utils/post";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((p) => ({ params: { slug: p.id } }));
}

const { slug } = Astro.params;
const entry = await getEntry("posts", slug!);

if (!entry) {
  return new Response("文章未找到", { status: 404 });
}

const { Content, headings } = await render(entry);

/* ---- 构建大纲树形结构 ---- */
interface TocNode {
  depth: number;
  slug: string;
  text: string;
  children: TocNode[];
}

function buildTocTree(items: typeof headings): TocNode[] {
  const root: TocNode[] = [];
  const stack: TocNode[] = [];
  for (const h of items) {
    const node: TocNode = { depth: h.depth, slug: h.slug, text: h.text, children: [] };
    while (stack.length > 0 && stack[stack.length - 1].depth >= h.depth) {
      stack.pop();
    }
    if (stack.length === 0) {
      root.push(node);
    } else {
      stack[stack.length - 1].children.push(node);
    }
    stack.push(node);
  }
  return root;
}

const tocTree = buildTocTree(headings);

/* ---- 递归渲染大纲 HTML ---- */
function getIndentStyle(depth: number): string {
  const base = 12;
  const extra = (depth - 2) * 16;
  return `padding-left: ${base + extra}px`;
}

function getSizeClass(depth: number): string {
  if (depth <= 2) return "text-sm";
  if (depth <= 4) return "text-xs";
  return "text-[0.65rem]";
}

function renderToc(nodes: TocNode[]): string {
  if (!nodes.length) return "";
  let h = '<ul class="space-y-0.5">';
  for (const node of nodes) {
    const hasKids = node.children.length > 0;
    h += "<li>";
    h += '<div class="flex items-center gap-0.5">';
    if (hasKids) {
      h +=
        '<button class="toc-arrow w-6 h-6 flex items-center justify-center text-[0.65rem] text-muted dark:text-muted-dark hover:text-accent hover:border-accent cursor-pointer select-none bg-transparent border border-border-light dark:border-border-dark rounded transition-colors duration-200 shrink-0" aria-label="折叠/展开">▼</button>';
    } else {
      h += '<span class="inline-block w-6 shrink-0"></span>';
    }
    h +=
      `<a href="#${node.slug}" data-toc-link="${node.slug}" style="${getIndentStyle(node.depth)}" class="${getSizeClass(node.depth)} block py-1 transition-colors no-underline hover:text-accent text-muted dark:text-muted-dark">${node.text}</a>`;
    h += "</div>";
    if (hasKids) {
      h += renderToc(node.children);
    }
    h += "</li>";
  }
  h += "</ul>";
  return h;
}

const tocHtml = headings.length > 0 ? renderToc(tocTree) : "";
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.coverImage ?? "/favicon.svg"}
>
  <!-- 大纲侧边栏的移动端遮罩层 -->
  <div
    id="toc-overlay"
    class="toc-overlay fixed inset-0 bg-black/40 z-40 hidden"
    aria-hidden="true"
  ></div>

  <!-- 移动端浮动按钮：打开大纲栏 -->
  <button
    id="toc-mobile-open"
    class="lg:hidden fixed left-3 bottom-6 z-30 w-10 h-10 rounded-full border border-border-light dark:border-border-dark bg-cream dark:bg-night shadow-lg flex items-center justify-center text-muted dark:text-muted-dark hover:text-accent transition-colors cursor-pointer"
    aria-label="打开大纲栏"
  >
    <svg
      class="w-5 h-5 pointer-events-none"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    >
      <path d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </button>

  <!-- 返回按钮 -->
  <button
    onclick="history.back()"
    class="inline-flex items-center px-3 py-1 rounded-full text-xs border border-border-light dark:border-border-dark text-muted dark:text-muted-dark hover:border-accent hover:text-accent dark:hover:text-accent transition-colors bg-transparent cursor-pointer mb-6"
  >
    &larr; 返回
  </button>

  <!-- ====== 桌面端：面板 + 正文 flex 布局，整体居中 ====== -->
  <div id="toc-group" class="toc-group hidden lg:flex mx-auto items-start">
    <!-- 大纲面板：sticky 悬浮，始终可见 -->
    {
      tocHtml && (
        <aside
          id="toc-panel"
          class="
            toc-panel
            shrink-0
            sticky top-32
            rounded-xl
            border border-border-light dark:border-border-dark
            bg-cream dark:bg-night
            shadow-lg
            overflow-hidden
          "
        >
          <div class="toc-panel-header flex items-center justify-between px-4 py-2.5 border-b border-border-light dark:border-border-dark">
            <h4 class="text-xs font-semibold uppercase tracking-wider text-muted dark:text-muted-dark">
              目录
            </h4>
            <button
              id="toc-toggle-btn"
              class="
                toc-toggle-btn
                w-7 h-7
                rounded-full
                border border-border-light dark:border-border-dark
                bg-cream dark:bg-night
                flex items-center justify-center
                text-muted dark:text-muted-dark
                hover:text-accent hover:border-accent
                cursor-pointer
                shrink-0
              "
              aria-label="切换大纲栏"
            >
              <svg
                class="w-3.5 h-3.5 pointer-events-none"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M11 17l-5-5 5-5" /><path d="M18 17l-5-5 5-5" />
              </svg>
            </button>
          </div>

          <div id="toc-content" class="toc-panel-content px-4 py-3 max-h-[60vh] overflow-y-auto">
            <nav id="toc-nav" class="toc-nav" set:html={tocHtml}></nav>
          </div>
        </aside>
      )
    }

    <!-- 文章内容 -->
    <article id="article-content" class="flex-1 min-w-0 py-8" data-pagefind-body>
      <h1 class="text-3xl sm:text-4xl font-bold mb-4 text-ink dark:text-ghost">
        {entry.data.title}
      </h1>

      <div class="flex flex-wrap items-center gap-3 text-sm text-muted dark:text-muted-dark mb-6">
        <span>
          发布于 <time datetime={formatDate(entry.data.published)}>{formatDate(entry.data.published)}</time>
        </span>
        {
          entry.data.updated && entry.data.updated.getTime() !== entry.data.published.getTime() ? (
            <span>
              更新于 <time datetime={formatDate(entry.data.updated)}>{formatDate(entry.data.updated)}</time>
            </span>
          ) : null
        }
      </div>

      {entry.data.coverImage ? (
        <img src={entry.data.coverImage} alt={entry.data.title} class="w-full rounded-lg mb-8" />
      ) : null}

      {
        entry.data.tags && entry.data.tags.length > 0 ? (
          <div class="flex flex-wrap gap-2 mb-8">
            {entry.data.tags.map((tag) => (
              <a
                href={`/tags/${encodeURIComponent(tag)}`}
                class="inline-block px-2.5 py-0.5 rounded-full text-xs font-medium border border-border-light dark:border-border-dark text-muted dark:text-muted-dark hover:border-accent hover:text-accent dark:hover:text-accent transition-colors no-underline"
              >
                {tag}
              </a>
            ))}
          </div>
        ) : null
      }

      <div class="prose mt-8">
        <Content />
      </div>
    </article>
  </div>

  <!-- ====== 移动端：仅文章居中 ====== -->
  <article class="lg:hidden mx-auto max-w-3xl py-8" data-pagefind-body>
    <h1 class="text-3xl sm:text-4xl font-bold mb-4 text-ink dark:text-ghost">
      {entry.data.title}
    </h1>

    <div class="flex flex-wrap items-center gap-3 text-sm text-muted dark:text-muted-dark mb-6">
      <span>
        发布于 <time datetime={formatDate(entry.data.published)}>{formatDate(entry.data.published)}</time>
      </span>
      {
        entry.data.updated && entry.data.updated.getTime() !== entry.data.published.getTime() ? (
          <span>
            更新于 <time datetime={formatDate(entry.data.updated)}>{formatDate(entry.data.updated)}</time>
          </span>
        ) : null
      }
    </div>

    {entry.data.coverImage ? (
      <img src={entry.data.coverImage} alt={entry.data.title} class="w-full rounded-lg mb-8" />
    ) : null}

    {
      entry.data.tags && entry.data.tags.length > 0 ? (
        <div class="flex flex-wrap gap-2 mb-8">
          {entry.data.tags.map((tag) => (
            <a
              href={`/tags/${encodeURIComponent(tag)}`}
              class="inline-block px-2.5 py-0.5 rounded-full text-xs font-medium border border-border-light dark:border-border-dark text-muted dark:text-muted-dark hover:border-accent hover:text-accent dark:hover:text-accent transition-colors no-underline"
            >
              {tag}
            </a>
          ))}
        </div>
      ) : null
    }

    <div class="prose mt-8">
      <Content />
    </div>
  </article>

  <!-- 移动端大纲抽屉 -->
  {
    tocHtml && (
      <aside
        id="toc-sidebar"
        class="
          toc-sidebar
          lg:hidden fixed
          top-0 left-0
          z-50
          h-full w-64
          bg-cream dark:bg-night
          shadow-2xl
          px-5 py-6
          overflow-y-auto
          -translate-x-full
          transition-transform duration-300
        "
      >
        <button
          id="toc-close-btn"
          class="absolute top-4 right-4 w-8 h-8 rounded-full border border-border-light dark:border-border-dark flex items-center justify-center text-muted dark:text-muted-dark hover:text-accent transition-colors bg-transparent cursor-pointer"
          aria-label="关闭大纲栏"
        >
          <svg
            class="w-4 h-4 pointer-events-none"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <path d="M18 6L6 18" /><path d="M6 6l12 12" />
          </svg>
        </button>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-muted dark:text-muted-dark mb-3">
          目录
        </h4>
        <nav class="toc-nav" set:html={tocHtml}></nav>
      </aside>
    )
  }
</BaseLayout>

<script>
  /* ======== 大纲栏交互脚本 ======== */
  const panel = document.getElementById("toc-panel");
  const sidebar = document.getElementById("toc-sidebar");
  const overlay = document.getElementById("toc-overlay");
  const toggleBtn = document.getElementById("toc-toggle-btn");
  const closeBtn = document.getElementById("toc-close-btn");
  const mobileOpenBtn = document.getElementById("toc-mobile-open");
  const article = document.getElementById("article-content");

  /* ---- 桌面端：面板折叠/展开 + 宽度适配 ---- */
  if (panel && toggleBtn) {
    let tocExpanded = true;
    const tocGroup = document.getElementById("toc-group");

    function clampValue(vw: number, minVw: number, maxVw: number, minVal: number, maxVal: number): number {
      const t = Math.max(0, Math.min(1, (vw - minVw) / (maxVw - minVw)));
      return minVal + t * (maxVal - minVal);
    }

    function collapsePanel() {
      panel!.classList.add("collapsed");
      toggleBtn!.classList.add("rotated");
      tocExpanded = false;
      updateLayoutWidths();
    }

    function expandPanel() {
      panel!.classList.remove("collapsed");
      toggleBtn!.classList.remove("rotated");
      tocExpanded = true;
      updateLayoutWidths();
    }

    toggleBtn.addEventListener("click", () => {
      if (tocExpanded) collapsePanel();
      else expandPanel();
    });

    /* 动态调整：响应式边距 + 面板/正文宽度，整体居中，至少占 70vw */
    function updateLayoutWidths() {
      if (!article || !tocGroup || window.innerWidth < 1024) return;
      const vw = window.innerWidth;
      const pw = panel ? panel.offsetWidth : 0;

      // 间距：48px（1024px 屏）→ 64px（1600px+ 屏）
      const gap = clampValue(vw, 1024, 1600, 48, 64);

      // 目标侧边距：16px（窄屏）→ 96px（宽屏），保证 group ≥ 70vw
      const sideMargin = clampValue(vw, 1024, 1600, 16, 96);
      const available = vw - 2 * sideMargin;

      // 文章自然宽度上限：640px → 800px
      const articleCap = clampValue(vw, 1024, 1600, 640, 800);

      // group 最大宽度：≥ 70vw，≤ 可用宽，≤ 面板+间距+文章上限
      const naturalWidth = pw + gap + articleCap;
      const groupMax = Math.max(vw * 0.7, Math.min(available, naturalWidth));

      tocGroup.style.maxWidth = groupMax + "px";
      tocGroup.style.gap = gap + "px";

      const articleMax = groupMax - pw - gap;
      article.style.maxWidth = articleMax + "px";
    }

    window.addEventListener("resize", updateLayoutWidths);
    updateLayoutWidths();
  }

  /* ---- 移动端：抽屉式大纲栏 ---- */
  if (sidebar) {
    function openSidebar() {
      sidebar!.classList.add("toc-open");
      sidebar!.classList.remove("-translate-x-full");
      overlay?.classList.remove("hidden");
      if (mobileOpenBtn) mobileOpenBtn.style.display = "none";
    }

    function closeSidebar() {
      sidebar!.classList.remove("toc-open");
      sidebar!.classList.add("-translate-x-full");
      overlay?.classList.add("hidden");
      if (mobileOpenBtn) mobileOpenBtn.style.display = "";
    }

    mobileOpenBtn?.addEventListener("click", () => openSidebar());
    closeBtn?.addEventListener("click", () => closeSidebar());
    overlay?.addEventListener("click", () => closeSidebar());

    /* 移动端 TOC 链接点击后关闭抽屉 */
    sidebar.querySelectorAll("[data-toc-link]").forEach((link) => {
      link.addEventListener("click", () => closeSidebar());
    });
  }

  /* ======== 折叠/展开箭头 ======== */
  document.querySelectorAll(".toc-arrow").forEach((arrow) => {
    arrow.addEventListener("click", (e) => {
      e.stopPropagation();
      const li = (e.target as HTMLElement).closest("li");
      if (!li) return;
      const childUl = li.querySelector(":scope > ul");
      if (!childUl) return;

      const isCollapsed = childUl.classList.contains("hidden");
      if (isCollapsed) {
        childUl.classList.remove("hidden");
        (e.target as HTMLElement).style.transform = "rotate(0deg)";
      } else {
        childUl.classList.add("hidden");
        (e.target as HTMLElement).style.transform = "rotate(-90deg)";
      }
    });
  });

  /* ======== 平滑滚动 + 移动端关闭侧边栏 ======== */
  document.querySelectorAll("[data-toc-link]").forEach((link) => {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      const id = (e.target as HTMLElement).getAttribute("data-toc-link");
      if (!id) return;
      const target = document.getElementById(id);
      if (target) {
        target.scrollIntoView({ behavior: "smooth" });
      }
      if (window.innerWidth < 1024) {
        sidebar?.classList.add("-translate-x-full");
        sidebar?.classList.remove("toc-open");
        overlay?.classList.add("hidden");
      }
    });
  });

  /* ======== IntersectionObserver 滚动高亮 ======== */
  const headingEls = document.querySelectorAll("h2[id], h3[id], h4[id], h5[id], h6[id]");
  if (headingEls.length > 0) {
    const observedMap = new Map<Element, boolean>();

    function updateActiveHighlight(activeId: string) {
      document.querySelectorAll("[data-toc-link]").forEach((el) => {
        const link = el as HTMLElement;
        const isActive = link.getAttribute("data-toc-link") === activeId;
        if (isActive) {
          link.classList.add("toc-link-active");
        } else {
          link.classList.remove("toc-link-active");
        }
      });

      const activeLink = document.querySelector(`[data-toc-link="${activeId}"]`);
      if (activeLink) {
        let parent = activeLink.closest("ul")?.parentElement;
        while (parent && parent.tagName === "LI") {
          const childUl = parent.querySelector(":scope > ul");
          if (childUl && childUl.classList.contains("hidden")) {
            childUl.classList.remove("hidden");
            const arrowEl = parent.querySelector(":scope > div > .toc-arrow") as HTMLElement;
            if (arrowEl) arrowEl.style.transform = "rotate(0deg)";
          }
          parent = parent.closest("ul")?.parentElement;
        }
      }
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          observedMap.set(entry.target, entry.isIntersecting);
        }

        const visible: Element[] = [];
        for (const [el, isIntersecting] of observedMap) {
          if (isIntersecting) visible.push(el);
        }
        visible.sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top);

        if (visible.length > 0) {
          const docEl = document.documentElement;
          const atBottom = (window.scrollY + window.innerHeight) >= (docEl.scrollHeight - 5);
          const activeId = atBottom ? visible[visible.length - 1].id : visible[0].id;
          updateActiveHighlight(activeId);
          return;
        }

        let lastAbove: Element | null = null;
        let lastAboveTop = -Infinity;
        for (const [el, _] of observedMap) {
          const top = el.getBoundingClientRect().top;
          if (top < 0 && top > lastAboveTop) {
            lastAbove = el;
            lastAboveTop = top;
          }
        }
        if (lastAbove) updateActiveHighlight(lastAbove.id);
      },
      { rootMargin: "-80px 0px 0px 0px", threshold: 0 },
    );

    headingEls.forEach((el) => observer.observe(el));

    let scrollRaf = false;
    window.addEventListener("scroll", () => {
      if (scrollRaf) return;
      scrollRaf = true;
      requestAnimationFrame(() => {
        scrollRaf = false;
        const docEl = document.documentElement;
        const atBottom = (window.scrollY + window.innerHeight) >= (docEl.scrollHeight - 5);
        if (!atBottom) return;

        let lastVisible: Element | null = null;
        let lastVisibleTop = -Infinity;
        for (const [el, isIntersecting] of observedMap) {
          if (isIntersecting) {
            const top = el.getBoundingClientRect().top;
            if (top > lastVisibleTop) {
              lastVisible = el;
              lastVisibleTop = top;
            }
          }
        }
        if (lastVisible) updateActiveHighlight(lastVisible.id);
      });
    }, { passive: true });
  }
</script>

<style>
  /* Flex 容器：面板 + gap + 正文，整体居中，gap 响应式缩放 */
  .toc-group {
    gap: clamp(2.5rem, 4vw, 4rem);
    transition: gap 0.4s cubic-bezier(0.4, 0, 0.2, 1), max-width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* 面板宽度：折叠/展开过渡 */
  .toc-panel {
    width: 14rem;
    transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .toc-panel.collapsed {
    width: 6rem;
  }

  /* 文章宽度：随面板展开/折叠同步过渡 */
  #article-content {
    transition: max-width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* 面板内容折叠动画 */
  .toc-panel-content {
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s ease, padding 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    max-height: 60vh;
    opacity: 1;
  }
  .toc-panel.collapsed .toc-panel-content {
    max-height: 0;
    opacity: 0;
    padding-top: 0;
    padding-bottom: 0;
  }

  /* 面板折叠时隐藏底部分隔线 */
  .toc-panel.collapsed .toc-panel-header {
    border-bottom-color: transparent;
  }
  .toc-panel-header {
    transition: border-bottom-color 0.2s;
  }

  /* 切换按钮旋转 */
  .toc-toggle-btn {
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.2s, color 0.2s;
  }
  .toc-toggle-btn.rotated {
    transform: rotate(180deg);
  }
</style>

<style is:global>
  /* 文章页加宽主容器 */
  main {
    max-width: 90rem;
  }

  /* 移动端侧边栏打开状态 */
  .toc-sidebar.toc-open {
    transform: translateX(0);
  }

  @media (max-width: 1023px) {
    .toc-sidebar {
      padding-top: 3.5rem;
    }
  }

  /* 激活的 TOC 链接 */
  .toc-link-active {
    color: #0891b2 !important;
    font-weight: 600;
    background: linear-gradient(to right, #0891b2 3px, transparent 3px);
  }

  :root.dark .toc-link-active {
    color: #22d3ee !important;
    background: linear-gradient(to right, #22d3ee 3px, transparent 3px);
  }
</style>
