---
/* [tag].astro — 标签详情页，展示指定标签下的所有文章 */

import { getCollection } from "astro:content";
import { getAllTags, getWordCount } from "../../utils/post";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";

/* getStaticPaths：为每个标签生成静态页面 */
export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const tags = getAllTags(posts);
  return tags.map((t) => ({ params: { tag: t.name } }));
}

/* 当前路由参数 */
const { tag } = Astro.params;

/* 筛选包含该标签的文章，按发布日期降序排列 */
const allPosts = await getCollection("posts");
const filteredPosts = allPosts
  .filter((p) => p.data.tags?.includes(tag!))
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
---

<BaseLayout
  title={`标签: ${tag}`}
  description={`浏览标签为「${tag}」的所有文章。`}
>
  <section class="py-8">
    <!-- 返回标签列表 -->
    <a
      href="/tags"
      class="inline-block text-sm text-muted dark:text-muted-dark hover:text-accent dark:hover:text-accent transition-colors no-underline mb-6"
    >
      &larr; 返回标签列表
    </a>

    <!-- 标签标题 -->
    <h1 class="text-3xl sm:text-4xl font-bold mb-2 text-ink dark:text-ghost">
      {tag}
    </h1>
    <p class="text-muted dark:text-muted-dark mb-8">
      共 {filteredPosts.length} 篇{filteredPosts.length > 1 ? "文章" : "文章"}
    </p>

    <!-- 文章列表 -->
    {
      filteredPosts.length > 0 ? (
        <div class="flex flex-col gap-6">
          {filteredPosts.map((post) => (
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              published={post.data.published}
              updated={post.data.updated}
              tags={post.data.tags}
              wordCount={getWordCount(post.body ?? "")}
              slug={post.id}
            />
          ))}
        </div>
      ) : (
        <p class="text-center text-muted dark:text-muted-dark py-16">该标签下暂无文章</p>
      )
    }
  </section>
</BaseLayout>
