---
/* blog.astro — 博客页，两栏布局：归档时间轴（左）+ 合集/标签（右），左栏带翻页 */

import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getWordCount, groupPostsByYearMonth, getAllTags, getSets } from "../utils/post";
import type { YearGroup } from "../utils/post";
import BlogSearchOverlay from "../components/BlogSearchOverlay.astro";
import BlogPagination from "../components/BlogPagination.astro";
import BlogSidebar from "../components/BlogSidebar.astro";

/* 获取所有文章，按发布日期降序排列 */
const allPosts = await getCollection("posts");
allPosts.sort((a, b) => b.data.published.getTime() - a.data.published.getTime());

/* 标签：全部用于计数，右侧仅展示热门 12 个 */
const tags = getAllTags(allPosts);
const hotTags = tags.slice(0, 12);

/* 合集：分组后仅展示前 4 个热门合集 */
const sets = getSets(allPosts);
const hotSets = sets.slice(0, 4);

/* 翻页：每页 30 篇文章，预计算每页的年月分组 */
const POSTS_PER_PAGE = 30;
const totalPages = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));

const pages: YearGroup[][] = [];
for (let i = 0; i < allPosts.length; i += POSTS_PER_PAGE) {
  const pagePosts = allPosts.slice(i, i + POSTS_PER_PAGE);
  pages.push(groupPostsByYearMonth(pagePosts));
}
---

<BaseLayout
  title="博客"
  description="浏览所有博客文章，按时间线归档或按标签筛选。"
>
  <section class="py-8">
    <!-- 搜索 -->
    <BlogSearchOverlay tags={tags} sets={sets} />

    <!-- 两栏布局 -->
    <div
      class="grid grid-cols-1 lg:grid-cols-[3fr_1fr] gap-8 lg:gap-10"
    >
      <!-- ========== 左栏：归档时间轴 + 翻页 ========== -->
      <div>
        {
          pages.map((yearGroups, pageIndex) => (
            <div
              data-page={pageIndex + 1}
              class:list={["page-content", { hidden: pageIndex > 0 }]}
            >
              {
                yearGroups.map((yearGroup) => (
                  <div class="mt-10 first:mt-0">
                    <h2
                      class="flex items-center gap-4 mb-6 text-2xl sm:text-3xl font-bold text-accent"
                    >
                      {yearGroup.year}
                      <span
                        class="flex-1 h-px bg-border-light dark:bg-border-dark"
                      ></span>
                    </h2>

                    <div
                      class="ml-2 sm:ml-4 border-l-2 border-border-light dark:border-border-dark"
                    >
                      {yearGroup.months.map((monthGroup) => (
                        <div
                          class="flex items-start gap-x-3 sm:gap-x-4 pb-6 last:pb-0"
                        >
                          <div
                            class="shrink-0 -ml-[6px] mt-[0.5rem] sm:mt-[0.55rem]"
                          >
                            <div
                              class="w-2.5 h-2.5 rounded-full bg-accent ring-2 ring-[var(--bg-color,#FFFAF0)]"
                            ></div>
                          </div>

                          <div class="flex-1 min-w-0">
                            <h3
                              class="text-lg font-semibold text-ink dark:text-ghost mb-3"
                            >
                              {monthGroup.month}月
                            </h3>

                            <div class="space-y-4">
                              {monthGroup.posts.map((post) => (
                                <ArticleCard
                                  title={post.title}
                                  description={post.description}
                                  published={post.published}
                                  updated={post.updated}
                                  tags={post.tags}
                                  wordCount={getWordCount(post.body)}
                                  slug={post.slug}
                                />
                              ))}
                            </div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                ))
              }
            </div>
          ))
        }

        <!-- 翻页 -->
        <BlogPagination totalPages={totalPages} totalPosts={allPosts.length} />
      </div>

      <!-- ========== 右栏：合集 + 热门标签 ========== -->
      <BlogSidebar
        hotSets={hotSets.map(s => ({ name: s.name, count: s.count }))}
        hotTags={hotTags}
        totalSets={sets.length}
      />
    </div>
  </section>
</BaseLayout>
